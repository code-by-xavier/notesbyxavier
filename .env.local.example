# ==============================================================================
# File: .env.local.example
# Description: Example local configuration (safe to commit).
# Copy this file to `.env.local` to customize your local development secrets.
# ==============================================================================

# --- Database Credentials ---
POSTGRES_USER=notesby
POSTGRES_PASSWORD=notesby
POSTGRES_DB=notesby
POSTGRES_PORT=5432

# --- Server & Network ---
PORT=4330
HOST=0.0.0.0
PUBLIC_SITE_URL=http://localhost:4330

# --- Security & Setup ---
SESSION_SECRET=dev_session_secret_change_in_production_min_32_characters_random
NOTESBY_SETUP_COMPLETED=false

# --- Claude Code (OpenRouter) ---
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-sonnet-5.5
