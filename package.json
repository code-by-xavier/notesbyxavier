{
  "name": "notesby",
  "version": "1.0.0",
  "description": "An open-source, minimalist static publishing engine where every post is a note. Built for distraction-free reading, editorial essays, and sovereign cloud deployment.",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4330",
    "start": "astro dev --port 4330",
    "build": "astro build",
    "preview": "astro preview --port 4330",
    "typecheck": "astro check && tsc --noEmit",
    "validate": "tsx ./scripts/validate.ts && astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.18.2",
    "reading-time": "^1.5.0",
    "sass": "^1.83.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "author": "Xavier Lawrence <XLawrence@clstre.com> (https://notesbyxavier.com)",
  "homepage": "https://github.com/CLSTRE-ORG/Notesby",
  "bugs": {
    "url": "https://github.com/CLSTRE-ORG/Notesby/issues",
    "email": "support@clstre.com"
  },
  "license": "MIT"
}
