---
// File: src/components/ui/FormError.astro
// ============================================================
// Notesby — Reusable Red Form Error Alert Banner
// Accessible error banner with high contrast, alert icon, and
// dynamic show/hide capability for client-side forms.
// ============================================================

interface Props {
  id?: string;
  message?: string;
  class?: string;
}

const { id, message, class: className = '' } = Astro.props;
const hasInitialMessage = Boolean(message);
---

<div
  id={id}
  class:list={['ui-form-error', className]}
  role="alert"
  aria-live="assertive"
  style={!hasInitialMessage && id ? 'display: none;' : undefined}
>
  <svg
    class="ui-form-error__icon"
    viewBox="0 0 24 24"
    width="16"
    height="16"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="10" />
    <line x1="12" y1="8" x2="12" y2="12" />
    <line x1="12" y1="16" x2="12.01" y2="16" />
  </svg>
  <div class="ui-form-error__message">{message || <slot />}</div>
</div>

<style lang="scss">
  @use '@/styles/abstracts' as ui;

  .ui-form-error {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-xs, #{ui.$spacing-xs});
    padding: var(--spacing-sm, #{ui.$spacing-sm}) var(--spacing-md, #{ui.$spacing-md});
    border-radius: var(--border-radius-md, #{ui.$border-radius-md});
    background-color: rgba(239, 68, 68, 0.08);
    border: var(--border-width-base, #{ui.$border-width-base}) solid rgba(239, 68, 68, 0.35);
    color: var(--error-color, #{ui.$error-color});
    font-family: var(--font-family-base, #{ui.$font-family-base});
    font-size: var(--font-size-sm, #{ui.$font-size-sm});
    line-height: var(--line-height-normal, 1.45);

    &__icon {
      flex-shrink: 0;
      margin-top: 2px;
      stroke: var(--error-color, #{ui.$error-color});
    }

    &__message {
      flex: 1;
      font-weight: ui.$font-weight-medium;
    }
  }
</style>
