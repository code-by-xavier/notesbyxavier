---
// File: src/components/ui/HelperText.astro
// ============================================================
// Notesby — Reusable Portal Guidance & Field Helper Text
// Provides contextual instructions, field hints, and portal navigation tips.
// ============================================================

import Icon from '@/components/Icon.astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'p'> {
  variant?: 'default' | 'info' | 'warning' | 'muted' | 'tip';
  id?: string;
  icon?: boolean;
  class?: string;
}

const { variant = 'default', id, icon = false, class: className = '', ...rest } = Astro.props;
---

<p
  id={id}
  class:list={[
    'ui-helper-text',
    `ui-helper-text--${variant}`,
    { 'ui-helper-text--with-icon': icon },
    className,
  ]}
  {...rest}
>
  {icon && variant === 'info' && <Icon name="help-circle" size={14} class="ui-helper-text__icon" />}
  {icon && variant === 'tip' && <Icon name="sun" size={14} class="ui-helper-text__icon" />}
  {icon && variant === 'warning' && (
    <Icon name="alert-triangle" size={14} class="ui-helper-text__icon" />
  )}
  <span class="ui-helper-text__content">
    <slot />
  </span>
</p>

<style lang="scss">
  @use '@/styles/abstracts' as ui;

  .ui-helper-text {
    font-family: var(--font-family-base, #{ui.$font-family-base});
    font-size: var(--font-size-xs, #{ui.$font-size-xs});
    line-height: var(--line-height-normal, 1.45);
    margin: 0;
    color: var(--text-secondary, #{ui.$text-secondary-light});

    &--with-icon {
      display: inline-flex;
      align-items: flex-start;
      gap: var(--spacing-2xs, #{ui.$spacing-2xs});
    }

    &__icon {
      flex-shrink: 0;
      margin-top: 2px;
    }

    &__content {
      flex: 1;
    }

    &--muted {
      color: var(--text-muted, #{ui.$text-muted-light});
    }

    &--info {
      color: var(--accent-color, #{ui.$primary-accent});

      .ui-helper-text__icon {
        stroke: var(--accent-color, #{ui.$primary-accent});
      }
    }

    &--tip {
      color: var(--text-secondary, #{ui.$text-secondary-light});

      .ui-helper-text__icon {
        stroke: var(--accent-color, #{ui.$primary-accent});
      }
    }

    &--warning {
      color: var(--warning-color, #{ui.$warning-color});

      .ui-helper-text__icon {
        stroke: var(--warning-color, #{ui.$warning-color});
      }
    }
  }
</style>
