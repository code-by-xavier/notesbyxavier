---
// File: src/components/TableOfContents.astro
// ============================================================
// Notesby — Table of Contents Component
// Sticky sidebar tracking headings and scroll progress in essays.
// ============================================================

export interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
}

const { headings = [] } = Astro.props;
// Filter to top level headings (h2, h3)
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside class="toc" id="toc-sidebar" aria-label="Table of contents">
  <div class="toc__inner">
    <div class="toc__title">Contents</div>
    <nav class="toc__nav">
      <ul class="toc__list">
        {filteredHeadings.map((heading, idx) => (
          <li class:list={['toc__item', `toc__item--depth-${heading.depth}`]}>
            <a href={`#${heading.slug}`} class="toc__link" data-slug={heading.slug}>
              {heading.depth === 2 && <span class="toc__number">{idx + 1}. </span>}
              <span class="toc__text">{heading.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</aside>

<style lang="scss">
  .toc {
    display: none;

    @include ui.media-breakpoint-up(lg) {
      display: block;
      width: var(--sidebar-width, #{ui.$sidebar-width});
      flex-shrink: 0;
      position: sticky;
      top: calc(var(--header-height, #{ui.$header-height}) + var(--spacing-xl, #{ui.$spacing-xl}));
      max-height: calc(
        100vh - var(--header-height, #{ui.$header-height}) - var(--spacing-5xl, #{ui.$spacing-5xl})
      );
      overflow-y: auto;
      padding-right: var(--spacing-xl, #{ui.$spacing-xl});
      @include ui.custom-scrollbar;
    }

    &__title {
      font-family: var(--font-family-headings, #{ui.$font-family-headings});
      font-size: var(--h3-size, #{ui.$h3-font-size});
      font-weight: ui.$font-weight-semibold;
      color: var(--text-primary, #{ui.$text-primary-light});
      margin-bottom: var(--spacing-md-plus, #{ui.$spacing-md-plus});
    }

    &__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm, #{ui.$spacing-sm});
    }

    &__item {
      &--depth-3 {
        padding-left: var(--spacing-unit, #{ui.$spacing-unit});
        font-size: var(--font-size-sm, #{ui.$font-size-sm});
      }
    }

    &__link {
      font-family: var(--font-family-base, #{ui.$font-family-base});
      font-size: var(--font-size-nav, #{ui.$font-size-nav});
      color: var(--text-muted, #{ui.$text-muted-light});
      line-height: var(--line-height-base, #{ui.$line-height-base});
      display: block;
      transition:
        color ui.$transition-fast,
        transform ui.$transition-fast;

      &:hover {
        color: var(--text-primary, #{ui.$text-primary-light});
      }

      &.is-active {
        color: var(--text-primary, #{ui.$text-primary-light});
        font-weight: ui.$font-weight-medium;
      }
    }

    &__number {
      opacity: 0.7;
      margin-right: var(--spacing-3xs, #{ui.$spacing-3xs});
    }
  }
</style>

<script>
  function setupActiveHeadingTracker() {
    const links = document.querySelectorAll('.toc__link');
    if (links.length === 0) return;

    const headingElements = Array.from(links)
      .map((link) => {
        const slug = link.getAttribute('data-slug');
        return slug ? document.getElementById(slug) : null;
      })
      .filter((el): el is HTMLElement => Boolean(el));

    if (headingElements.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            links.forEach((link) => {
              if (link.getAttribute('data-slug') === id) {
                link.classList.add('is-active');
              } else {
                link.classList.remove('is-active');
              }
            });
          }
        });
      },
      { rootMargin: '-80px 0% -70% 0%', threshold: 0 }
    );

    headingElements.forEach((el) => observer.observe(el));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupActiveHeadingTracker);
  } else {
    setupActiveHeadingTracker();
  }
</script>
