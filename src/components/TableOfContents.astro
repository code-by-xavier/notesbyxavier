---
export interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
}

const { headings = [] } = Astro.props;
// Filter to top level headings (h2, h3)
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside class="toc" id="toc-sidebar" aria-label="Table of contents">
  <div class="toc__inner">
    <div class="toc__title">Contents</div>
    <nav class="toc__nav">
      <ul class="toc__list">
        {filteredHeadings.map((heading, idx) => (
          <li class:list={['toc__item', `toc__item--depth-${heading.depth}`]}>
            <a href={`#${heading.slug}`} class="toc__link" data-slug={heading.slug}>
              {heading.depth === 2 && <span class="toc__number">{idx + 1}. </span>}
              <span class="toc__text">{heading.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</aside>

<style lang="scss">
  .toc {
    display: none;

    @media (min-width: 1024px) {
      display: block;
      width: var(--sidebar-width);
      flex-shrink: 0;
      position: sticky;
      top: calc(var(--header-height) + 2rem);
      max-height: calc(100vh - var(--header-height) - 4rem);
      overflow-y: auto;
      padding-right: 2rem;
    }

    &__title {
      font-family: 'Newsreader', Charter, Georgia, serif;
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 1.25rem;
    }

    &__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    &__item {
      &--depth-3 {
        padding-left: 1rem;
        font-size: 0.875rem;
      }
    }

    &__link {
      font-size: 0.9375rem;
      color: var(--text-muted);
      line-height: 1.4;
      display: block;
      transition: color 0.15s ease, transform 0.15s ease;

      &:hover {
        color: var(--text-primary);
      }

      &.is-active {
        color: var(--text-primary);
        font-weight: 500;
      }
    }

    &__number {
      opacity: 0.7;
      margin-right: 0.2rem;
    }
  }
</style>

<script>
  function setupActiveHeadingTracker() {
    const links = document.querySelectorAll('.toc__link');
    if (links.length === 0) return;

    const headingElements = Array.from(links)
      .map((link) => {
        const slug = link.getAttribute('data-slug');
        return slug ? document.getElementById(slug) : null;
      })
      .filter((el): el is HTMLElement => Boolean(el));

    if (headingElements.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            links.forEach((link) => {
              if (link.getAttribute('data-slug') === id) {
                link.classList.add('is-active');
              } else {
                link.classList.remove('is-active');
              }
            });
          }
        });
      },
      { rootMargin: '-80px 0% -70% 0%', threshold: 0 }
    );

    headingElements.forEach((el) => observer.observe(el));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupActiveHeadingTracker);
  } else {
    setupActiveHeadingTracker();
  }
</script>
