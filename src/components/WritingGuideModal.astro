---
// File: src/components/WritingGuideModal.astro
// ============================================================
// Notesby — Writing Guide & Markdown Syntax Modal
// Interactive searchable documentation modal with dark shaded backdrop,
// live instant filtering, click-to-copy snippets, and keyboard navigation.
// ============================================================

import Icon from '@/components/Icon.astro';

interface GuideItem {
  id: string;
  category: string;
  title: string;
  description: string;
  syntax: string;
  example?: string;
  note?: string;
}

const guideItems: GuideItem[] = [
  {
    id: 'headings-h2',
    category: 'Headings',
    title: 'H2 Section Heading (Table of Contents)',
    description:
      'Primary editorial section heading. Automatically generates an entry in the reader Table of Contents.',
    syntax: '## Section Title',
    example: '## The Architecture of Sovereign Clouds',
    note: 'Generates anchor link #the-architecture-of-sovereign-clouds automatically.',
  },
  {
    id: 'headings-h3',
    category: 'Headings',
    title: 'H3 Sub-heading',
    description: 'Nested subsection heading indented under its parent H2 in the Table of Contents.',
    syntax: '### Sub-heading Title',
    example: '### Database Storage Layer',
  },
  {
    id: 'headings-h4',
    category: 'Headings',
    title: 'H4 Minor Heading',
    description: 'Deep section subdivision for specific technical items or minor paragraphs.',
    syntax: '#### Minor Heading',
  },
  {
    id: 'hashtags',
    category: 'Hashtags & Tags',
    title: 'Hashtags / Tags',
    description:
      'Tag your essays with topics to display badges on note preview cards across the feed.',
    syntax: '#Architecture  #CloudRun  #Essays',
    example: '#Sovereignty #Research',
    note: 'Tags appear on note cards as high-contrast topic pills.',
  },
  {
    id: 'links-internal-anchor',
    category: 'Links',
    title: 'Internal Section Anchor Link',
    description:
      'Jump to any section on the same page using its automatically slugified heading ID.',
    syntax: '[Jump to Core Thesis](#the-core-thesis)',
    example: '[Read our conclusion](#conclusion)',
    note: 'Slugs are lowercase with hyphens replacing spaces.',
  },
  {
    id: 'links-internal-note',
    category: 'Links',
    title: 'Linking to Other Notes',
    description:
      'Create internal backlinks to other published essays and field notes on your site.',
    syntax: '[Title of Note](/notes/note-slug/)',
    example: '[Getting Started with Notesby](/notes/getting-started/)',
    note: 'Always include the trailing slash for optimal edge caching.',
  },
  {
    id: 'links-external',
    category: 'Links',
    title: 'External Web Links',
    description:
      'Standard hyperlinks connecting readers to external sources, research, and platforms.',
    syntax: '[CLSTRE Platform](https://clstre.com)',
    example: '[Google Cloud Run](https://cloud.google.com/run)',
  },
  {
    id: 'quotes-blockquote',
    category: 'Quotes & Callouts',
    title: 'Editorial Blockquote',
    description:
      'Featured high-contrast quotation with Newsreader italic typography and left accent border.',
    syntax: '> "Simplicity is my prerequisite for reliability."\n> — Jane Doe',
  },
  {
    id: 'quotes-callout',
    category: 'Quotes & Callouts',
    title: 'Field Note Callout Box',
    description:
      'Framed highlight box for important notices, research caveats, and field dispatches.',
    syntax: '> [!NOTE]\n> Sovereign publishing engines provide true content ownership.',
  },
  {
    id: 'lists-bullet',
    category: 'Lists',
    title: 'Bulleted List',
    description: 'Unordered list for items, principles, or summaries.',
    syntax:
      '- Field Notes (100–300 words)\n- Editorial Essays (Long-form)\n- Op-Eds (Perspectives)',
  },
  {
    id: 'lists-numbered',
    category: 'Lists',
    title: 'Numbered Step List',
    description: 'Ordered sequence for walkthroughs, tutorials, or numbered arguments.',
    syntax: '1. Connect Cloud SQL\n2. Launch Cloud Run container\n3. Publish first essay',
  },
  {
    id: 'text-formatting',
    category: 'Text Emphasis',
    title: 'Bold, Italic & Inline Code',
    description: 'Inline typography stylings to emphasize prose.',
    syntax: '**Bold thesis**, *italic observation*, and `inline_code()`.',
    example: '**Crucial:** Always keep `dependencies` lean.',
  },
  {
    id: 'code-block',
    category: 'Code',
    title: 'Fenced Code Block',
    description: 'Syntax-highlighted code container with language specification.',
    syntax: '```ts\nexport const sovereign = true;\n```',
  },
  {
    id: 'media-image',
    category: 'Media',
    title: 'Images & Figures',
    description: 'Editorial figure with responsive auto-scaling and accessible alt caption.',
    syntax: '![Architecture Diagram](/images/diagram.webp)',
  },
  {
    id: 'divider',
    category: 'Dividers',
    title: 'Horizontal Section Divider',
    description: 'Subtle editorial separator rule between prose movements.',
    syntax: '---',
  },
  {
    id: 'cover-image',
    category: 'Media',
    title: 'Post Headline Cover Image',
    description:
      'Upload a single high-resolution cover image at the top of your post in Notesby Studio. Displays across the top of the reading canvas and serves as the og:image in search engines and social cards.',
    syntax: 'Click "Add Cover Image" above your note title',
    note: 'Optimal dimensions: 1200x630 (16:9). Supports JPEG, PNG, WebP, AVIF, and GIF up to 5MB.',
  },
  {
