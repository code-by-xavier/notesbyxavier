const categories = Array.from(new Set(guideItems.map((g) => g.category)));
---

<!-- Writing Guide Modal & Dark Backdrop -->
<div
  id="writing-guide-modal"
  class="guide-modal-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="guide-modal-title"
  style="display: none;"
>
  <div class="guide-modal" id="guide-modal-container">
    <!-- Modal Header -->
    <header class="guide-modal__header">
      <div class="guide-modal__title-group">
        <span class="guide-modal__icon">
          <Icon name="book-open" size={20} />
        </span>
        <div>
          <h2 id="guide-modal-title" class="guide-modal__title">
            Writing & Formatting Guide
          </h2>
          <p class="guide-modal__subtitle">
            Markdown syntax, Table of Contents anchors, hashtags, and Notesby Studio shortcuts.
          </p>
        </div>
      </div>

      <button
        type="button"
        id="guide-modal-close"
        class="guide-modal__close-btn"
        aria-label="Close Writing Guide"
        title="Close (Esc)"
      >
        <Icon name="x" size={18} />
      </button>
    </header>

    <!-- Modal Search Filter Bar -->
    <div class="guide-modal__search-wrapper">
      <div class="guide-modal__search-box">
        <span class="guide-modal__search-icon">
          <Icon name="search" size={16} />
        </span>
        <input
          type="text"
          id="guide-search-input"
          class="guide-modal__search-input"
          placeholder="Search writing guide (e.g. hashtags, h2, internal links, quote, code)..."
          autocomplete="off"
          spellcheck="false"
        />
        <button
          type="button"
          id="guide-search-clear"
          class="guide-modal__search-clear"
          style="display: none;"
          aria-label="Clear Search"
        >
          <Icon name="x" size={14} />
        </button>
      </div>

      <!-- Category Filter Pills -->
      <div class="guide-modal__pills" id="guide-category-pills">
        <button type="button" class="guide-pill guide-pill--active" data-cat="all">
          All
        </button>
        {categories.map((cat) => (
          <button type="button" class="guide-pill" data-cat={cat}>
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Modal Scrollable Content Body -->
    <div class="guide-modal__body" id="guide-modal-body">
      <div class="guide-grid" id="guide-items-grid">
        {guideItems.map((item) => (
          <div
            class="guide-card"
            data-guide-id={item.id}
            data-category={item.category}
            data-search={`${item.title} ${item.description} ${item.syntax} ${item.category} ${item.note || ''}`.toLowerCase()}
          >
            <div class="guide-card__header">
              <span class="guide-card__category">{item.category}</span>
              <h3 class="guide-card__title">{item.title}</h3>
            </div>

            <p class="guide-card__description">{item.description}</p>

            <div class="guide-card__snippet-wrapper">
              <pre class="guide-card__syntax"><code>{item.syntax}</code></pre>
              <button
                type="button"
                class="guide-card__copy-btn"
                data-copy={item.syntax}
                title="Click to copy syntax"
              >
                Copy
              </button>
            </div>

            {item.example && (
              <div class="guide-card__example">
                <span class="guide-card__example-label">Example:</span>
                <code>{item.example}</code>
              </div>
            )}

            {item.note && <p class="guide-card__note">{item.note}</p>}
          </div>
        ))}
      </div>

      <!-- Empty Search State -->
      <div id="guide-empty-state" class="guide-empty-state" style="display: none;">
        <p class="guide-empty-state__title">No matching guides found</p>
        <p class="guide-empty-state__text">
          Try searching for "headings", "links", "hashtags", or "quotes".
        </p>
        <button type="button" id="guide-empty-reset" class="guide-empty-state__btn">
          View All Guides
        </button>
      </div>
    </div>

    <!-- Modal Footer -->
    <footer class="guide-modal__footer">
      <div class="guide-modal__footer-left">
        <span class="guide-modal__kbd-hint">
          <kbd>?</kbd> Toggle Guide
        </span>
        <span class="guide-modal__kbd-hint">
          <kbd>/</kbd> Focus Search
        </span>
        <span class="guide-modal__kbd-hint">
          <kbd>Esc</kbd> Close
        </span>
      </div>
      <div class="guide-modal__footer-right">
        <span id="guide-count-label" class="guide-modal__count">
          Showing all guides
        </span>
      </div>
    </footer>
  </div>
</div>

<script>
  function setupWritingGuideModal() {
    const modal = document.getElementById('writing-guide-modal');
    const closeBtn = document.getElementById('guide-modal-close');
    const searchInput = document.getElementById('guide-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('guide-search-clear');
    const emptyState = document.getElementById('guide-empty-state');
    const emptyResetBtn = document.getElementById('guide-empty-reset');
    const countLabel = document.getElementById('guide-count-label');
    const cards = document.querySelectorAll<HTMLElement>('.guide-card');
    const categoryPills = document.querySelectorAll<HTMLButtonElement>('.guide-pill');
    const openBtns = document.querySelectorAll('[data-trigger-guide]');

    let activeCategory = 'all';

    function openModal() {
      if (!modal) return;
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        searchInput?.focus();
      }, 50);
    }

    function closeModal() {
      if (!modal) return;
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }

    // Connect all elements configured with data-trigger-guide or id open-guide-btn
    openBtns.forEach((btn) => btn.addEventListener('click', openModal));
    document.getElementById('open-guide-btn')?.addEventListener('click', openModal);

    closeBtn?.addEventListener('click', closeModal);

    // Backdrop click to close (when clicking outside the container)
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Keyboard Shortcuts: '?' to toggle, 'Esc' to close, '/' to focus search
    window.addEventListener('keydown', (e) => {
      // Don't trigger if user is actively typing in a form input or textarea
      const targetTag = (e.target as HTMLElement)?.tagName?.toLowerCase();
      const isInput = targetTag === 'input' || targetTag === 'textarea';

      if (e.key === '?' && !isInput) {
        e.preventDefault();
        if (modal?.style.display === 'flex') {
          closeModal();
        } else {
          openModal();
        }
      } else if (e.key === 'Escape' && modal?.style.display === 'flex') {
        e.preventDefault();
        closeModal();
      } else if (e.key === '/' && modal?.style.display === 'flex' && !isInput) {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    // Real-time Search and Category Filter
    function filterCards() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      if (clearBtn) {
        clearBtn.style.display = query.length > 0 ? 'inline-flex' : 'none';
      }

      let visibleCount = 0;

      cards.forEach((card) => {
        const searchText = card.getAttribute('data-search') || '';
        const cardCategory = card.getAttribute('data-category') || '';

        const matchesQuery = query === '' || searchText.includes(query);
        const matchesCategory = activeCategory === 'all' || cardCategory === activeCategory;

        if (matchesQuery && matchesCategory) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      if (countLabel) {
        countLabel.textContent = `Showing ${visibleCount} of ${cards.length} items`;
      }
    }

    searchInput?.addEventListener('input', filterCards);

    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
        filterCards();
      }
    });

    emptyResetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      activeCategory = 'all';
      categoryPills.forEach((p) =>
        p.classList.toggle('guide-pill--active', p.getAttribute('data-cat') === 'all')
      );
      filterCards();
    });

    // Category Pill Click
    categoryPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        activeCategory = pill.getAttribute('data-cat') || 'all';
        categoryPills.forEach((p) => p.classList.remove('guide-pill--active'));
        pill.classList.add('guide-pill--active');
        filterCards();
      });
    });

    // Click to copy syntax snippet
    cards.forEach((card) => {
      const copyBtn = card.querySelector<HTMLButtonElement>('.guide-card__copy-btn');
      if (!copyBtn) return;

      copyBtn.addEventListener('click', async () => {
        const text = copyBtn.getAttribute('data-copy') || '';
        try {
          await navigator.clipboard.writeText(text);
          const original = copyBtn.textContent;
          copyBtn.textContent = 'Copied!';
          copyBtn.classList.add('guide-card__copy-btn--copied');
          setTimeout(() => {
            copyBtn.textContent = original;
            copyBtn.classList.remove('guide-card__copy-btn--copied');
          }, 1800);
        } catch {
          // Fallback
        }
      });
    });
  }

  // Setup on page load and on Astro navigation
  setupWritingGuideModal();
  document.addEventListener('astro:page-load', setupWritingGuideModal);
</script>

<style lang="scss">
  @use '@/styles/abstracts' as ui;

  // Dark Shaded Backdrop Overlay
  .guide-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-md, #{ui.$spacing-md});
    background-color: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: guide-overlay-fade 0.2s ease-out;
  }

  // Modal Container Box
  .guide-modal {
    width: 100%;
    max-width: 820px;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    background-color: var(--surface-color, #{ui.$surface-light});
    color: var(--text-primary, #{ui.$text-primary-light});
    border: var(--border-width-base, #{ui.$border-width-base}) solid
      var(--border-color, #{ui.$border-light});
    border-radius: var(--border-radius-lg, #{ui.$border-radius-lg});
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    animation: guide-modal-pop 0.22s cubic-bezier(0.16, 1, 0.3, 1);

    &__header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--spacing-md, #{ui.$spacing-md});
      padding: var(--spacing-lg, #{ui.$spacing-lg}) var(--spacing-xl, #{ui.$spacing-xl});
      border-bottom: var(--border-width-base, #{ui.$border-width-base}) solid
        var(--border-subtle, #{ui.$border-subtle-light});
      background-color: var(--bg-color, #{ui.$bg-light});
    }

    &__title-group {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm, #{ui.$spacing-sm});
    }

    &__icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: var(--border-radius-md, #{ui.$border-radius-md});
      background-color: rgba(7, 90, 170, 0.1);
      color: var(--accent-color, #{ui.$primary-accent});
      flex-shrink: 0;
    }

    &__title {
      @include ui.h3-heading-style;
      margin: 0 0 2px 0;
      font-size: var(--font-size-md, #{ui.$font-size-md});
    }

    &__subtitle {
      @include ui.description-text;
      font-size: var(--font-size-xs, #{ui.$font-size-xs});
      margin: 0;
    }

    &__close-btn {
      @include ui.flex-center;
      width: 32px;
      height: 32px;
      border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});
      border: var(--border-width-base, #{ui.$border-width-base}) solid
        var(--border-subtle, #{ui.$border-subtle-light});
      background: transparent;
      color: var(--text-secondary, #{ui.$text-secondary-light});
      cursor: pointer;
      transition: all ui.$transition-fast;

      &:hover {
        background-color: var(--tag-bg, #{ui.$tag-bg-light});
        color: var(--text-primary, #{ui.$text-primary-light});
      }
    }

    // Search Section
    &__search-wrapper {
      padding: var(--spacing-md, #{ui.$spacing-md}) var(--spacing-xl, #{ui.$spacing-xl})
        var(--spacing-sm, #{ui.$spacing-sm});
      background-color: var(--surface-color, #{ui.$surface-light});
      border-bottom: var(--border-width-base, #{ui.$border-width-base}) solid
        var(--border-subtle, #{ui.$border-subtle-light});
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm, #{ui.$spacing-sm});
    }

    &__search-box {
      position: relative;
      display: flex;
      align-items: center;
    }

    &__search-icon {
      position: absolute;
      left: 12px;
      color: var(--text-muted, #{ui.$text-muted-light});
      display: inline-flex;
      pointer-events: none;
    }

    &__search-input {
      width: 100%;
      padding: 10px 36px 10px 38px;
      background-color: var(--bg-color, #{ui.$bg-light});
      border: var(--border-width-base, #{ui.$border-width-base}) solid
        var(--border-color, #{ui.$border-light});
      border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});
      color: var(--text-primary, #{ui.$text-primary-light});
      font-family: var(--font-family-base, #{ui.$font-family-base});
      font-size: var(--font-size-sm, #{ui.$font-size-sm});
      outline: none;
      transition: border-color ui.$transition-fast;

      &:focus {
        border-color: var(--accent-color, #{ui.$primary-accent});
      }
    }

    &__search-clear {
      position: absolute;
      right: 10px;
      @include ui.flex-center;
      width: 20px;
      height: 20px;
      border: none;
      background: transparent;
      color: var(--text-muted, #{ui.$text-muted-light});
      cursor: pointer;

      &:hover {
        color: var(--text-primary, #{ui.$text-primary-light});
      }
    }

    // Pills Bar
    &__pills {
      display: flex;
      gap: var(--spacing-2xs, #{ui.$spacing-2xs});
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 2px;

      &::-webkit-scrollbar {
        display: none;
      }
    }

    // Scrollable Guide Body
    &__body {
      flex: 1;
      overflow-y: auto;
      padding: var(--spacing-lg, #{ui.$spacing-lg}) var(--spacing-xl, #{ui.$spacing-xl});
    }

    // Footer
    &__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: var(--spacing-sm, #{ui.$spacing-sm}) var(--spacing-xl, #{ui.$spacing-xl});
      border-top: var(--border-width-base, #{ui.$border-width-base}) solid
        var(--border-subtle, #{ui.$border-subtle-light});
      background-color: var(--bg-color, #{ui.$bg-light});
      font-family: var(--font-family-base, #{ui.$font-family-base});
      font-size: var(--font-size-2xs, #{ui.$font-size-2xs});
      color: var(--text-muted, #{ui.$text-muted-light});
    }

    &__footer-left {
      display: flex;
      gap: var(--spacing-md, #{ui.$spacing-md});
    }

    &__kbd-hint {
      display: inline-flex;
      align-items: center;
      gap: 4px;

      kbd {
        display: inline-block;
        padding: 1px 5px;
        font-family: var(--font-family-mono, #{ui.$font-family-mono});
        font-size: 10px;
        background-color: var(--surface-color, #{ui.$surface-light});
        border: var(--border-width-base, #{ui.$border-width-base}) solid
          var(--border-color, #{ui.$border-light});
        border-radius: var(--border-radius-xs, #{ui.$border-radius-xs});
        color: var(--text-primary, #{ui.$text-primary-light});
      }
    }
  }

  // Filter Pills
  .guide-pill {
    padding: 3px 10px;
    font-family: var(--font-family-base, #{ui.$font-family-base});
    font-size: var(--font-size-2xs, #{ui.$font-size-2xs});
    font-weight: ui.$font-weight-medium;
    border-radius: var(--border-radius-full, #{ui.$border-radius-full});
    border: var(--border-width-base, #{ui.$border-width-base}) solid
      var(--border-subtle, #{ui.$border-subtle-light});
    background-color: var(--bg-color, #{ui.$bg-light});
    color: var(--text-secondary, #{ui.$text-secondary-light});
    cursor: pointer;
    white-space: nowrap;
    transition: all ui.$transition-fast;

    &:hover {
      border-color: var(--accent-color, #{ui.$primary-accent});
      color: var(--text-primary, #{ui.$text-primary-light});
    }

    &--active {
      background-color: var(--accent-color, #{ui.$primary-accent});
      border-color: var(--accent-color, #{ui.$primary-accent});
      color: #ffffff;

      &:hover {
        color: #ffffff;
      }
    }
  }

  // Grid of Guide Cards
  .guide-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md, #{ui.$spacing-md});

    @include ui.media-breakpoint-up(md) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .guide-card {
    @include ui.card-surface-style;
    padding: var(--spacing-md, #{ui.$spacing-md});
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--bg-color, #{ui.$bg-light});
    border: var(--border-width-base, #{ui.$border-width-base}) solid
      var(--border-subtle, #{ui.$border-subtle-light});

    &__header {
      margin-bottom: var(--spacing-2xs, #{ui.$spacing-2xs});
    }

    &__category {
      display: inline-block;
      font-size: 10px;
      font-weight: ui.$font-weight-bold;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--accent-color, #{ui.$primary-accent});
      margin-bottom: 2px;
    }

    &__title {
      font-family: var(--font-family-base, #{ui.$font-family-base});
      font-size: var(--font-size-sm, #{ui.$font-size-sm});
