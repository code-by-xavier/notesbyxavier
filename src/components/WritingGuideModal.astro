    title: 'Slash Commands (Notesby Studio Shortcut)',
    description:
      'While writing in Notesby Studio, type "/" at the beginning of any empty line to trigger instant insertion.',
    syntax: '/h2   /h3   /quote   /code   /list   /divider   /callout',
    note: 'Press Enter or click any command in the popover to insert instantly.',
  },
