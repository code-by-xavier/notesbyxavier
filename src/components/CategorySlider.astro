---
// File: src/components/CategorySlider.astro
// ============================================================
// Notesby — Category Slider Component
// Displays notes categorized in responsive horizontal sliders.
// ============================================================

import NoteCard from '@/components/NoteCard.astro';
import Icon from '@/components/Icon.astro';
import type { NoteCardItem } from '@/lib/notes';
import type { CollectionEntry } from 'astro:content';

type SliderItem = NoteCardItem | CollectionEntry<'notes'>;

interface Props {
  title: string;
  description?: string;
  notes: SliderItem[];
}

const { title, description, notes } = Astro.props;
const sliderId = `slider-${title.toLowerCase().replace(/[^a-z0-9]/g, '-')}`;

function normalize(n: SliderItem): NoteCardItem {
  if ('data' in n) {
    return {
      id: n.id,
      slug: n.id.replace(/\.(md|mdx)$/, ''),
      title: n.data.title,
      subtitle: n.data.subtitle,
      description: n.data.description,
      pubDate: n.data.pubDate,
      tags: n.data.tags,
      category: n.data.category,
      readingTime: '5 min read',
      coverImage: n.data.coverImage,
    };
  }
  return n;
}
---

<section class="category-slider" data-category-slider id={sliderId}>
  <div class="category-slider__header">
    <div class="category-slider__info">
      <div class="category-slider__title-row">
        <h2 class="category-slider__title">{title}</h2>
        <span class="category-slider__count">
          {notes.length} {notes.length === 1 ? 'note' : 'notes'}
        </span>
      </div>
      {description && <p class="category-slider__description">{description}</p>}
    </div>

    <div class="category-slider__controls" aria-label={`Controls for ${title} slider`}>
      <button
        type="button"
        class="slider-btn slider-btn--prev"
        data-slider-prev
        aria-label={`Scroll ${title} left`}
        disabled
      >
        <Icon name="chevron-left" size={16} />
      </button>

      <button
        type="button"
        class="slider-btn slider-btn--next"
        data-slider-next
        aria-label={`Scroll ${title} right`}
      >
        <Icon name="chevron-right" size={16} />
      </button>
    </div>
  </div>

  <div class="category-slider__viewport">
    <div class="category-slider__track" data-slider-track>
      {notes.map((rawNote) => {
        const note = normalize(rawNote);
        return (
          <div class="category-slider__item">
            <NoteCard
              title={note.title}
              subtitle={note.subtitle || undefined}
              description={note.description}
              slug={note.slug}
              pubDate={note.pubDate}
              tags={note.tags}
              category={note.category}
              readingTime={note.readingTime}
              coverImage={note.coverImage || undefined}
            />
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  function setupCategorySliders() {
    const sliders = document.querySelectorAll<HTMLElement>('[data-category-slider]');

    sliders.forEach((slider) => {
      const track = slider.querySelector<HTMLElement>('[data-slider-track]');
      const prevBtn = slider.querySelector<HTMLButtonElement>('[data-slider-prev]');
      const nextBtn = slider.querySelector<HTMLButtonElement>('[data-slider-next]');

      if (!track || !prevBtn || !nextBtn) return;

      const updateButtons = () => {
        const atStart = track.scrollLeft <= 5;
        const atEnd = track.scrollLeft >= track.scrollWidth - track.clientWidth - 5;
        prevBtn.disabled = atStart;
        nextBtn.disabled = atEnd;
      };

      const getScrollDistance = () => {
        const firstItem = track.querySelector<HTMLElement>('.category-slider__item');
        if (!firstItem) return 360;
        const itemWidth = firstItem.offsetWidth;
        const gap = parseFloat(window.getComputedStyle(track).gap) || 24;
        return itemWidth + gap;
      };

      prevBtn.addEventListener('click', () => {
        const distance = getScrollDistance();
        track.scrollBy({ left: -distance, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        const distance = getScrollDistance();
        track.scrollBy({ left: distance, behavior: 'smooth' });
      });

      track.addEventListener('scroll', updateButtons, { passive: true });
      window.addEventListener('resize', updateButtons, { passive: true });
      updateButtons();
    });
  }

  // Run on initial load
  setupCategorySliders();
  document.addEventListener('astro:page-load', setupCategorySliders);
</script>

<style lang="scss">
  .category-slider {
    margin-bottom: var(--page-section-gap, #{ui.$page-section-gap});

    &:last-child {
      margin-bottom: var(--spacing-lg, #{ui.$spacing-lg});
    }

    &__header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--spacing-unit, #{ui.$spacing-unit});
      margin-bottom: var(--spacing-md-plus, #{ui.$spacing-md-plus});
      padding-bottom: var(--spacing-sm, #{ui.$spacing-sm});
      border-bottom: var(--border-width-base, #{ui.$border-width-base}) solid
        var(--border-subtle, #{ui.$border-subtle-light});
    }

    &__info {
      flex: 1;
      min-width: 0;
    }

    &__title-row {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm, #{ui.$spacing-sm});
      margin-bottom: var(--spacing-2xs-plus, #{ui.$spacing-2xs-plus});
    }

    &__title {
      @include ui.h2-heading-style;
      margin: 0;
    }

    &__count {
      @include ui.badge-pill-style;
    }

    &__description {
      @include ui.description-text;
    }

    &__controls {
      display: flex;
      align-items: center;
      gap: var(--spacing-xs, #{ui.$spacing-xs});
      flex-shrink: 0;
    }

    .slider-btn {
      @include ui.flex-center;
      width: var(--slider-btn-size, #{ui.$slider-btn-size});
      height: var(--slider-btn-size, #{ui.$slider-btn-size});
      border-radius: var(--border-radius-full, #{ui.$border-radius-full});
      border: var(--border-width-base, #{ui.$border-width-base}) solid
        var(--border-color, #{ui.$border-light});
      background-color: var(--surface-color, #{ui.$surface-light});
      color: var(--text-primary, #{ui.$text-primary-light});
      cursor: pointer;
      transition: all ui.$transition-fast;

      &:hover:not(:disabled) {
        border-color: var(--accent-color, #{ui.$primary-accent});
        background-color: var(--accent-color, #{ui.$primary-accent});
        color: var(--white, #{ui.$surface-light});
      }

      &:disabled {
        opacity: 0.35;
        cursor: not-allowed;
      }
    }

    &__viewport {
      position: relative;
      overflow: hidden;
      margin: calc(-1 * var(--spacing-sm, #{ui.$spacing-sm}))
        calc(-1 * var(--spacing-sm, #{ui.$spacing-sm}));
      padding: var(--spacing-sm, #{ui.$spacing-sm});
    }

    &__track {
      display: flex;
      gap: var(--spacing-lg, #{ui.$spacing-lg});
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scroll-behavior: smooth;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      padding-top: var(--spacing-xs, #{ui.$spacing-xs});
      padding-bottom: var(--spacing-md, #{ui.$spacing-md});
      padding-left: var(--spacing-2xs, #{ui.$spacing-2xs});
      padding-right: var(--spacing-2xs, #{ui.$spacing-2xs});

      &::-webkit-scrollbar {
        display: none;
      }
    }

    &__item {
      flex: 0 0 var(--slider-item-min-width, #{ui.$slider-item-min-width});
      scroll-snap-align: start;
      max-width: 85vw;
      display: flex;

      @include ui.media-breakpoint-down(sm) {
        flex: 0 0 85vw;
      }
    }
  }
</style>
