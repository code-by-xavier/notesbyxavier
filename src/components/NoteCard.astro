---
// File: src/components/NoteCard.astro
// ============================================================
// Notesby — Note Card Component
// Compact card preview for essays, op-eds, and field notes.
// ============================================================

import { ROUTES } from '@/links';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  slug: string;
  pubDate: Date | string;
  tags?: string[];
  category?: string;
  readingTime?: string;
  coverImage?: string;
}

const {
  title,
  subtitle,
  description,
  slug,
  pubDate,
  tags = [],
  category,
  readingTime = '5 min read',
  coverImage,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  year: 'numeric',
}).format(new Date(pubDate));
---

<article class="note-card">
  <div class="note-card__content">
    <div class="note-card__header">
      <div class="note-card__meta">
        {category && <span class="note-card__category">{category}</span>}
        {category && <span class="note-card__dot">·</span>}
        <time datetime={new Date(pubDate).toISOString()}>{formattedDate}</time>
        <span class="note-card__dot">·</span>
        <span>{readingTime}</span>
      </div>

      {tags.length > 0 && (
        <div class="note-card__tags">
          {tags.slice(0, 2).map((tag) => (
            <span class="note-card__tag">#{tag}</span>
          ))}
        </div>
      )}
    </div>

    <h2 class="note-card__title">
      <a href={ROUTES.NOTE(slug)}>{title}</a>
    </h2>

    {subtitle && <p class="note-card__subtitle">{subtitle}</p>}
    <p class="note-card__description">{description}</p>
  </div>

  {coverImage && (
    <div class="note-card__thumbnail">
      <img src={coverImage} alt={title} loading="lazy" />
    </div>
  )}
</article>

<style lang="scss">
  .note-card {
    @include ui.card-surface-style;
    padding: var(--card-padding-y, #{ui.$card-padding-y})
      var(--card-padding-x, #{ui.$card-padding-x});
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
    box-sizing: border-box;

    &__content {
      width: 100%;
      min-width: 0;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    &__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--spacing-xs, #{ui.$spacing-xs});
      margin-bottom: var(--spacing-sm, #{ui.$spacing-sm});
      flex-wrap: nowrap;
    }

    &__meta {
      @include ui.meta-row-style(xs, 2xs-plus);
      text-transform: uppercase;
      white-space: nowrap;
    }

    &__category {
      font-weight: ui.$font-weight-semibold;
      color: var(--accent-color, #{ui.$primary-accent});
      letter-spacing: var(--letter-spacing-category, #{ui.$letter-spacing-category});
    }

    &__dot {
      opacity: 0.5;
    }

    &__tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-2xs-plus, #{ui.$spacing-2xs-plus});
      justify-content: flex-end;
    }

    &__tag {
      @include ui.tag-pill-style;
    }

    &__title {
      font-family: var(--font-family-headings, #{ui.$font-family-headings});
      font-size: var(--h3-size, #{ui.$h3-font-size});
      font-weight: ui.$font-weight-semibold;
      line-height: var(--line-height-tight, #{ui.$line-height-tight});
      letter-spacing: var(--letter-spacing-tighter, #{ui.$letter-spacing-tighter});
      margin-bottom: var(--spacing-2xs-plus, #{ui.$spacing-2xs-plus});
      @include ui.line-clamp(2);

      a {
        color: var(--text-primary, #{ui.$text-primary-light});
        text-decoration: none;

        &:hover {
          color: var(--accent-color, #{ui.$primary-accent});
        }
      }
    }

    &__subtitle {
      @include ui.subtitle-serif-style(subhead, 1);
      margin-bottom: var(--spacing-xs, #{ui.$spacing-xs});
    }

    &__description {
      @include ui.description-text(2);
    }

    &__thumbnail {
      margin-top: var(--spacing-sm, #{ui.$spacing-sm});
      width: 100%;
      height: var(--thumbnail-height, #{ui.$thumbnail-height});
      border-radius: var(--border-radius-base, #{ui.$border-radius-base});
      overflow: hidden;
      border: var(--border-width-base, #{ui.$border-width-base}) solid
        var(--border-color, #{ui.$border-light});

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
    }
  }
</style>
