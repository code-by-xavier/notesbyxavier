---
interface Props {
  title: string;
  subtitle?: string;
  description: string;
  slug: string;
  pubDate: Date | string;
  tags?: string[];
  category?: string;
  readingTime?: string;
  coverImage?: string;
}

const {
  title,
  subtitle,
  description,
  slug,
  pubDate,
  tags = [],
  category,
  readingTime = '5 min read',
  coverImage,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  year: 'numeric',
}).format(new Date(pubDate));
---

<article class="note-card">
  <div class="note-card__content">
    <div class="note-card__header">
      <div class="note-card__meta">
        {category && <span class="note-card__category">{category}</span>}
        {category && <span class="note-card__dot">·</span>}
        <time datetime={new Date(pubDate).toISOString()}>{formattedDate}</time>
        <span class="note-card__dot">·</span>
        <span>{readingTime}</span>
      </div>

      {tags.length > 0 && (
        <div class="note-card__tags">
          {tags.slice(0, 2).map((tag) => (
            <span class="note-card__tag">#{tag}</span>
          ))}
        </div>
      )}
    </div>

    <h2 class="note-card__title">
      <a href={`/notes/${slug}/`}>
        {title}
      </a>
    </h2>

    {subtitle && <p class="note-card__subtitle">{subtitle}</p>}
    <p class="note-card__description">{description}</p>
  </div>

  {coverImage && (
    <div class="note-card__thumbnail">
      <img src={coverImage} alt={title} loading="lazy" />
    </div>
  )}
</article>

<style lang="scss">
  .note-card {
    background-color: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.35rem 1.45rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;

    &:hover {
      transform: translateY(-2px);
      border-color: var(--accent-color);
      box-shadow: 0 8px 24px -8px rgba(7, 90, 170, 0.18);
    }

    &__content {
      width: 100%;
      min-width: 0;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    &__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0.6rem;
      flex-wrap: nowrap;
    }

    &__meta {
      font-family: var(--font-family-base);
      font-size: 0.72rem;
      font-weight: 500;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 0.35rem;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    &__category {
      font-weight: 600;
      color: var(--accent-color);
      letter-spacing: 0.03em;
    }

    &__dot {
      opacity: 0.5;
    }

    &__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      justify-content: flex-end;
    }

    &__tag {
      font-family: var(--font-family-base);
      font-size: 0.65rem;
      font-weight: 500;
      color: var(--tag-text);
      background-color: var(--tag-bg);
      padding: 0.12rem 0.45rem;
      border-radius: 4px;
      white-space: nowrap;
    }

    &__title {
      font-family: var(--font-family-headings);
      font-size: 1.35rem;
      font-weight: 600;
      line-height: 1.25;
      letter-spacing: -0.015em;
      margin-bottom: 0.35rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;

      a {
        color: var(--text-primary);
        text-decoration: none;

        &:hover {
          color: var(--accent-color);
        }
      }
    }

    &__subtitle {
      font-family: var(--font-family-serif);
      font-size: 0.90625rem;
      font-style: italic;
      color: var(--text-secondary);
      margin-bottom: 0.45rem;
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    &__description {
      font-family: var(--font-family-base);
      font-size: 0.8125rem;
      color: var(--text-secondary);
      line-height: 1.48;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    &__thumbnail {
      margin-top: 0.75rem;
      width: 100%;
      height: 70px;
      border-radius: 6px;
      overflow: hidden;
      border: 1px solid var(--border-color);

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
    }
  }
</style>
