---
// File: src/components/SEO.astro
// ============================================================
// Notesby — SEO & Document Head Metadata Component
// Standardizes meta tags, OpenGraph, Twitter cards, RSS feed,
// Google Fonts, and Schema.org structured data.
// ============================================================

import { notesConfig } from '@config';
import { getSiteSettings } from '@/lib/settings';
import { generateJsonLd } from '@/schemas';

interface Props {
  title?: string;
  description?: string;
  isEssay?: boolean;
  pubDate?: Date | string;
  updatedDate?: Date | string;
  image?: string;
  keywords?: string[] | string;
}

const settings = await getSiteSettings();

const {
  title = settings.siteTitle,
  description = settings.description,
  isEssay = false,
  pubDate,
  updatedDate,
  image = settings.ogImage || settings.authorAvatar,
  keywords,
} = Astro.props;

const pageTitle = title === settings.siteTitle ? title : `${title} — ${settings.siteTitle}`;
const canonicalUrl = new URL(Astro.url.pathname, settings.domain).href;
const resolvedOgImage = image
  ? image.startsWith('http')
    ? image
    : new URL(image, settings.domain).href
  : undefined;

const keywordsString = Array.isArray(keywords)
  ? keywords.join(', ')
  : typeof keywords === 'string'
    ? keywords
    : undefined;

const jsonLd = generateJsonLd({
  title,
  description,
  canonicalUrl,
  resolvedOgImage,
  isEssay,
  pubDate,
  updatedDate,
  keywords: keywordsString,
});
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
{keywordsString && <meta name="keywords" content={keywordsString} />}
<link rel="canonical" href={canonicalUrl} />

<!-- Favicon, Touch Icons & Web App Manifest -->
<link rel="icon" href={settings.favicon || '/favicon.webp'} />
<link rel="apple-touch-icon" href={settings.appleTouchIcon || '/images/notesby-logo-dark.png'} />
<link rel="manifest" href="/manifest.webmanifest" />

<!-- Open Graph (Facebook, LinkedIn, iMessage) -->
<meta property="og:type" content={isEssay ? 'article' : 'website'} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={settings.siteTitle} />
{resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
{resolvedOgImage && <meta property="og:image:alt" content={pageTitle} />}

<!-- Twitter Cards (X) -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
<meta name="twitter:creator" content="@clstre" />

<!-- Article Specific Metadata -->
{isEssay && pubDate && (
  <meta property="article:published_time" content={new Date(pubDate).toISOString()} />
)}
{isEssay && <meta property="article:author" content={settings.authorName} />}

<!-- JSON-LD Structured Data for Google Search Console & SEO -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

<!-- RSS Syndication -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${settings.siteTitle} RSS Feed`}
  href="/rss.xml"
/>

<!-- Google Fonts: Preload Inter, Poppins, Newsreader, JetBrains Mono -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,500&family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
  rel="stylesheet"
/>
