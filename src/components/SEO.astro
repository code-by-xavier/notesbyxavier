---
// File: src/components/SEO.astro
// ============================================================
// Notesby — SEO & Document Head Metadata Component
// Standardizes meta tags, OpenGraph, Twitter cards, RSS feed,
// Google Fonts, and Schema.org structured data.
// ============================================================

import { notesConfig } from '@config';
import { generateJsonLd } from '@/schemas';

interface Props {
  title?: string;
  description?: string;
  isEssay?: boolean;
  pubDate?: Date | string;
  updatedDate?: Date | string;
  image?: string;
}

const {
  title = notesConfig.siteTitle,
  description = notesConfig.description,
  isEssay = false,
  pubDate,
  updatedDate,
  image = notesConfig.ogImage || notesConfig.authorAvatar,
} = Astro.props;

const pageTitle = title === notesConfig.siteTitle ? title : `${title} — ${notesConfig.siteTitle}`;
const canonicalUrl = new URL(Astro.url.pathname, notesConfig.domain).href;
const resolvedOgImage = image ? new URL(image, notesConfig.domain).href : undefined;

const jsonLd = generateJsonLd({
  title,
  description,
  canonicalUrl,
  resolvedOgImage,
  isEssay,
  pubDate,
  updatedDate,
});
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Favicon & Touch Icons -->
<link
  rel="icon"
  type="image/webp"
  href={notesConfig.favicon || notesConfig.authorAvatar || '/favicon.webp'}
/>
<link
  rel="apple-touch-icon"
  href={notesConfig.favicon || notesConfig.authorAvatar || '/favicon.webp'}
/>

<!-- Open Graph (Facebook, LinkedIn, iMessage) -->
<meta property="og:type" content={isEssay ? 'article' : 'website'} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={notesConfig.siteTitle} />
{resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
{resolvedOgImage && <meta property="og:image:alt" content={pageTitle} />}

<!-- Twitter Cards (X) -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
<meta name="twitter:creator" content="@clstre" />

<!-- Article Specific Metadata -->
{isEssay && pubDate && (
  <meta property="article:published_time" content={new Date(pubDate).toISOString()} />
)}
{isEssay && <meta property="article:author" content={notesConfig.authorName} />}

<!-- JSON-LD Structured Data for Google Search Console & SEO -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

<!-- RSS Syndication -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${notesConfig.siteTitle} RSS Feed`}
  href="/rss.xml"
/>

<!-- Google Fonts: Preload Inter, Poppins, Newsreader, JetBrains Mono -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,500&family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
  rel="stylesheet"
/>
