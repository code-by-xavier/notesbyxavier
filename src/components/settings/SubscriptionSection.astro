---
// File: src/components/settings/SubscriptionSection.astro
// ============================================================
// Notesby — Email Subscription Settings Section
// Allows publishers to configure subscription copy, toggle
// the section and popup, and customize the confirmation page.
// ============================================================

import Icon from '@/components/Icon.astro';
import type { ResolvedSiteSettings } from '@/lib/settings';

interface Props {
  settings: ResolvedSiteSettings;
  defaults: ResolvedSiteSettings;
}

const { settings, defaults } = Astro.props;

const PLACEHOLDER_IMAGE = '/images/showcase-placeholder.svg';
const hasCustomShowcase =
  Boolean(settings.showcaseImage) &&
  settings.showcaseImage !== PLACEHOLDER_IMAGE &&
  settings.showcaseImage !== '/images/showcase-graphic.svg';
const previewImage = hasCustomShowcase ? settings.showcaseImage : PLACEHOLDER_IMAGE;
---

<section class="settings-card" id="subscription-settings">
  <div class="settings-card__header">
    <div class="settings-card__icon-wrap">
      <Icon name="mail" size={18} />
    </div>
    <div>
      <h2 class="settings-card__title">Audience Engagement &amp; Showcase</h2>
      <p class="settings-card__desc">
        Configure your email subscription form, and optionally a showcase banner promoting your
        software, products, projects, or services. The two can be shown together or on their own.
      </p>
    </div>
  </div>

  <div class="settings-card__body">
    <!-- Section Toggle -->
    <div class="form-group form-group--toggle">
      <div class="toggle-label-wrap">
        <label for="subscriptionEnabled" class="form-label form-label--inline">
          Enable email subscription form &amp; popup
        </label>
        <p class="form-help">
          When enabled, readers see the email opt-in form. Turning it off hides the form and popup.
          The Showcase Banner below is controlled separately.
        </p>
      </div>
      <label class="toggle-switch" aria-label="Enable email subscription">
        <input
          type="checkbox"
          id="subscriptionEnabled"
          name="subscriptionEnabled"
          class="toggle-switch__input"
          checked={settings.subscriptionEnabled}
        />
        <span class="toggle-switch__track"></span>
      </label>
    </div>

    <hr class="settings-divider" />

    <!-- Inline Section Copy -->
    <h3 class="settings-subheading">Inline Section</h3>
    <p class="form-help" style="margin-bottom: var(--spacing-lg);">
      Shown at the bottom of the home page and each post.
    </p>

    <div class="form-grid form-grid--2">
      <div class="form-group">
        <label for="subscriptionSectionHeadline" class="form-label">
          Section Headline
        </label>
        <input
          type="text"
          id="subscriptionSectionHeadline"
          name="subscriptionSectionHeadline"
          class="form-input"
          value={settings.subscriptionSectionHeadline}
          placeholder={defaults.subscriptionSectionHeadline}
        />
      </div>

      <div class="form-group">
        <label for="subscriptionSectionCtaLabel" class="form-label">
          CTA Button Label
        </label>
        <input
          type="text"
          id="subscriptionSectionCtaLabel"
          name="subscriptionSectionCtaLabel"
          class="form-input"
          value={settings.subscriptionSectionCtaLabel}
          placeholder={defaults.subscriptionSectionCtaLabel}
        />
      </div>
    </div>

    <div class="form-group">
      <label for="subscriptionSectionSubtext" class="form-label">
        Section Subtext
      </label>
      <textarea
        id="subscriptionSectionSubtext"
        name="subscriptionSectionSubtext"
        class="form-textarea form-textarea--short"
        rows="2"
        placeholder={defaults.subscriptionSectionSubtext}
      >{settings.subscriptionSectionSubtext}</textarea>
    </div>

    <hr class="settings-divider" />

    <!-- Popup Copy -->
    <div class="form-group form-group--toggle">
      <div class="toggle-label-wrap">
        <label for="subscriptionPopupEnabled" class="form-label form-label--inline">
          Enable exit-intent popup
        </label>
        <p class="form-help">
          Exit-intent on desktop, 70% scroll-depth on mobile. Once per session.
        </p>
      </div>
      <label class="toggle-switch" aria-label="Enable subscription popup">
        <input
          type="checkbox"
          id="subscriptionPopupEnabled"
          name="subscriptionPopupEnabled"
          class="toggle-switch__input"
          checked={settings.subscriptionPopupEnabled}
        />
        <span class="toggle-switch__track"></span>
      </label>
    </div>

    <div class="form-grid form-grid--2">
      <div class="form-group">
        <label for="subscriptionPopupHeadline" class="form-label">
          Popup Headline
        </label>
        <input
          type="text"
          id="subscriptionPopupHeadline"
          name="subscriptionPopupHeadline"
          class="form-input"
          value={settings.subscriptionPopupHeadline}
          placeholder={defaults.subscriptionPopupHeadline}
        />
      </div>
    </div>

    <div class="form-group">
      <label for="subscriptionPopupSubtext" class="form-label">
        Popup Subtext
      </label>
      <textarea
        id="subscriptionPopupSubtext"
        name="subscriptionPopupSubtext"
        class="form-textarea form-textarea--short"
        rows="2"
        placeholder={defaults.subscriptionPopupSubtext}
      >{settings.subscriptionPopupSubtext}</textarea>
    </div>

    <hr class="settings-divider" />

    <!-- Confirmation Page Copy -->
    <h3 class="settings-subheading">
      Confirmation Page <code>/subscribe/confirmed</code>
    </h3>
    <p class="form-help" style="margin-bottom: var(--spacing-lg);">
      Shown after a reader subscribes. Use this URL in Google Tag Manager to track conversions.
    </p>

    <div class="form-grid form-grid--2">
      <div class="form-group">
        <label for="subscriptionConfirmedHeadline" class="form-label">
          Confirmed Headline
        </label>
        <input
          type="text"
          id="subscriptionConfirmedHeadline"
          name="subscriptionConfirmedHeadline"
          class="form-input"
          value={settings.subscriptionConfirmedHeadline}
          placeholder={defaults.subscriptionConfirmedHeadline}
        />
      </div>
    </div>

    <div class="form-group">
      <label for="subscriptionConfirmedSubtext" class="form-label">
        Confirmed Subtext
      </label>
      <textarea
        id="subscriptionConfirmedSubtext"
        name="subscriptionConfirmedSubtext"
        class="form-textarea form-textarea--short"
        rows="2"
        placeholder={defaults.subscriptionConfirmedSubtext}
      >{settings.subscriptionConfirmedSubtext}</textarea>
      <p class="form-help">
        Social media links shown below this come from the <strong>SEO &amp; Social Profiles</strong>{' '}
        section.
      </p>
    </div>

    <hr class="settings-divider" />

    <!-- Generic Showcase / Promotion Callout Block -->
    <h3 class="settings-subheading">Generic Showcase Banner</h3>
    <p class="form-help" style="margin-bottom: var(--spacing-lg);">
      Displays a neat, high-impact rectangular card with a headline, subtext, call-to-action button,
      and showcase cover graphic.
    </p>

    <!-- Showcase Section Toggle -->
    <div class="form-group form-group--toggle">
      <div class="toggle-label-wrap">
        <label for="showcaseEnabled" class="form-label form-label--inline">
          Enable Showcase Banner
        </label>
        <p class="form-help">
          When turned on, displays the showcase banner across your home page and note footers,
          whether or not the email subscription form is enabled.
        </p>
      </div>
      <label class="toggle-switch" aria-label="Enable showcase banner">
        <input
          type="checkbox"
          id="showcaseEnabled"
          name="showcaseEnabled"
          class="toggle-switch__input"
          checked={settings.showcaseEnabled}
        />
        <span class="toggle-switch__track"></span>
      </label>
    </div>

    <div class="form-grid form-grid--2">
      <div class="form-group">
        <label for="showcaseEyebrow" class="form-label">
          Eyebrow Badge
        </label>
        <input
          type="text"
          id="showcaseEyebrow"
          name="showcaseEyebrow"
          class="form-input"
          value={settings.showcaseEyebrow}
          placeholder={defaults.showcaseEyebrow}
        />
      </div>

      <div class="form-group">
        <label for="showcaseHeadline" class="form-label">
          Showcase Headline
        </label>
        <input
          type="text"
          id="showcaseHeadline"
          name="showcaseHeadline"
          class="form-input"
          value={settings.showcaseHeadline}
          placeholder={defaults.showcaseHeadline}
        />
      </div>
    </div>

    <div class="form-group">
      <label for="showcaseSubtext" class="form-label">
        Showcase Subtext
      </label>
      <textarea
        id="showcaseSubtext"
        name="showcaseSubtext"
        class="form-textarea form-textarea--short"
        rows="2"
        placeholder={defaults.showcaseSubtext}
      >{settings.showcaseSubtext}</textarea>
    </div>

    <div class="form-grid form-grid--2">
      <div class="form-group">
        <label for="showcaseCtaLabel" class="form-label">
          CTA Button Label
        </label>
        <input
          type="text"
          id="showcaseCtaLabel"
          name="showcaseCtaLabel"
          class="form-input"
          value={settings.showcaseCtaLabel}
          placeholder={defaults.showcaseCtaLabel}
        />
      </div>

      <div class="form-group">
        <label for="showcaseCtaUrl" class="form-label">
          CTA Destination URL
        </label>
        <input
          type="text"
          id="showcaseCtaUrl"
          name="showcaseCtaUrl"
          class="form-input"
          value={settings.showcaseCtaUrl}
          placeholder={defaults.showcaseCtaUrl}
        />
      </div>
    </div>

    <!-- Gateway Image Upload -->
    <div class="form-group">
      <label class="form-label">Gateway Image Visual</label>
      <div class="media-upload-card" style="max-width: 380px; margin: 0 auto; width: 100%;">
        <span class="media-upload-label">Card Cover Graphic</span>
        <div class="media-upload-preview-wrap" style="width: 180px; height: 100px;">
          <img
            id="showcase-preview"
            src={previewImage}
            alt="Gateway Preview"
            class="media-upload-img"
            data-fallback={PLACEHOLDER_IMAGE}
          />
          <div id="showcase-loading" class="media-upload-loading" style="display: none;">
            <div class="upload-mini-spinner"></div>
          </div>
        </div>
        <input
          type="hidden"
          id="showcaseImage"
          name="showcaseImage"
          value={hasCustomShowcase ? settings.showcaseImage : ''}
        />
        <input
          type="file"
          id="showcase-file-input"
          accept="image/png,image/jpeg,image/webp,image/avif,image/gif,image/svg+xml"
          class="visually-hidden"
        />
        <div class="media-btn-row">
          <label
            for="showcase-file-input"
            id="upload-showcase-btn"
            class="media-upload-btn"
            role="button"
            tabindex="0"
          >
            <Icon name="image" size={13} />
            <span id="upload-showcase-btn-text">
              {hasCustomShowcase ? 'Change Gateway Image' : 'Upload Gateway Image'}
            </span>
          </label>
          <button
            type="button"
            id="remove-showcase-btn"
            class="media-upload-btn media-upload-btn--danger"
            title="Reset to Placeholder Graphic"
            style={hasCustomShowcase ? '' : 'display: none;'}
          >
            <Icon name="trash" size={12} />
            <span>Reset</span>
          </button>
        </div>
      </div>
      <p class="form-help" style="text-align: center; margin-top: var(--spacing-xs);">
        Upload a custom image to feature in the gateway card, or leave empty to use the clean
        default placeholder graphic.
      </p>
    </div>
  </div>
</section>
