---
// File: src/components/Header.astro
// ============================================================
// Notesby — Header Component
// Responsive navigation, author branding, avatar, RSS syndication,
// and accessible theme toggle.
// ============================================================

import ThemeToggle from '@/components/ThemeToggle.astro';
import Icon from '@/components/Icon.astro';
import { notesConfig } from '@config';
import { ROUTES } from '@/links';

interface Props {
  isEssay?: boolean;
}

const { isEssay = false } = Astro.props;
const avatarUrl = notesConfig.authorAvatar;
const initials = notesConfig.authorName
  .split(' ')
  .map((n) => n[0])
  .join('')
  .toUpperCase()
  .slice(0, 2);
---

<header class="site-header">
  <div class="site-header__container">
    <!-- Left: Author Brand / Return link -->
    <div class="site-header__left">
      <a href={ROUTES.HOME} class="site-header__brand" aria-label="Go to Home">
        {isEssay && (
          <span class="site-header__back-arrow" title="Back to all notes">
            <Icon name="arrow-left" size={16} />
          </span>
        )}
        <div class="site-header__avatar">
          {avatarUrl ? (
            <>
              <img
                src={avatarUrl}
                alt={notesConfig.authorName}
                class="avatar-img"
                onerror="this.style.display='none'; if (this.nextElementSibling) this.nextElementSibling.style.display='flex';"
              />
              <span class="avatar-fallback" style="display: none;">
                {initials}
              </span>
            </>
          ) : (
            <span class="avatar-fallback">{initials}</span>
          )}
        </div>
        <span class="site-header__name">{notesConfig.authorName}</span>
      </a>
    </div>

    <!-- Center: Clean spacing (empty to let content breathe) -->
    <div class="site-header__center"></div>

    <!-- Right: Mobile Notes link + Desktop Navigation + Theme Toggle -->
    <div class="site-header__right">
      <!-- Visible strictly on mobile: quick link to main notes feed -->
      <a href={ROUTES.HOME} class="site-header__mobile-link" aria-label="Go to main notes">
        Notes
      </a>

      <!-- Desktop Navigation -->
      <nav class="site-header__nav" aria-label="Main Navigation">
        {notesConfig.navLinks.map((link) => (
          <a
            href={link.href}
            class:list={['site-header__link', { 'site-header__link--rss': link.isRss }]}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {link.isRss && (
              <Icon name="rss" size={13} class="rss-icon" color="var(--rss-accent, #f97316)" />
            )}
            <span>{link.label}</span>
          </a>
        ))}
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style lang="scss">
  .site-header {
    width: 100%;
    height: var(--header-height, #{ui.$header-height});
    background-color: var(--bg-color, #{ui.$bg-light});
    position: sticky;
    top: 0;
    z-index: 100;
    transition: background-color ui.$transition-base;
    border-bottom: var(--border-width-base, #{ui.$border-width-base}) solid
      var(--border-subtle, #{ui.$border-subtle-light});

    &__container {
      @include ui.container;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    &__left {
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }

    &__brand {
      display: inline-flex;
      align-items: center;
      gap: var(--mobile-link-padding-x, #{ui.$mobile-link-padding-x});
      text-decoration: none;
      transition: opacity ui.$transition-fast;

      &:hover {
        opacity: 0.85;
      }
    }

    &__back-arrow {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted, #{ui.$text-muted-light});
      margin-right: calc(-1 * var(--spacing-3xs, #{ui.$spacing-3xs}));
      transition:
        transform ui.$transition-fast,
        color ui.$transition-fast;

      .site-header__brand:hover & {
        transform: translateX(calc(-1 * var(--border-radius-xs, #{ui.$border-radius-xs})));
        color: var(--text-primary, #{ui.$text-primary-light});
      }
    }

    &__avatar {
      @include ui.flex-center;
      width: var(--avatar-size, #{ui.$avatar-size});
      height: var(--avatar-size, #{ui.$avatar-size});
      border-radius: var(--border-radius-full, #{ui.$border-radius-full});
      overflow: hidden;
      background-color: var(--surface-color, #{ui.$surface-light});
      border: var(--border-width-bold, #{ui.$border-width-bold}) solid
        var(--border-color, #{ui.$border-light});
      box-shadow: ui.$shadow-sm;
      flex-shrink: 0;

      .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .avatar-fallback {
        font-family: var(--font-family-base, #{ui.$font-family-base});
        font-size: var(--font-size-xs, #{ui.$font-size-xs});
        font-weight: ui.$font-weight-semibold;
        color: var(--text-secondary, #{ui.$text-secondary-light});
        letter-spacing: var(--letter-spacing-meta, #{ui.$letter-spacing-meta});
      }
    }

    &__name {
      font-family: var(--font-family-base, #{ui.$font-family-base});
      font-size: var(--font-size-nav, #{ui.$font-size-nav});
      font-weight: ui.$font-weight-semibold;
      letter-spacing: var(--letter-spacing-tight, #{ui.$letter-spacing-tight});
      color: var(--text-primary, #{ui.$text-primary-light});
      white-space: nowrap;
    }

    &__center {
      flex: 1;
    }

    &__right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: var(--spacing-unit, #{ui.$spacing-unit});
      flex-shrink: 0;
    }

    // Mobile link to main notes feed
    &__mobile-link {
      font-family: var(--font-family-base, #{ui.$font-family-base});
      font-size: var(--font-size-sm, #{ui.$font-size-sm});
      font-weight: ui.$font-weight-semibold;
      color: var(--text-secondary, #{ui.$text-secondary-light});
      padding: var(--mobile-link-padding-y, #{ui.$mobile-link-padding-y})
        var(--mobile-link-padding-x, #{ui.$mobile-link-padding-x});
      border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});
      background-color: var(--surface-color, #{ui.$surface-light});
      border: var(--border-width-base, #{ui.$border-width-base}) solid
        var(--border-color, #{ui.$border-light});
      transition: all ui.$transition-fast;

      &:hover {
        color: var(--text-primary, #{ui.$text-primary-light});
        border-color: var(--accent-color, #{ui.$primary-accent});
      }

      @include ui.media-breakpoint-up(sm) {
        display: none;
      }
    }

    &__nav {
      display: none;
      align-items: center;
      gap: var(--spacing-md-plus, #{ui.$spacing-md-plus});

      @include ui.media-breakpoint-up(sm) {
        display: flex;
      }
    }

    &__link {
      @include ui.nav-link-style;

      &--rss {
        :global(.rss-icon),
        .rss-icon {
          color: var(--rss-accent, #{ui.$rss-accent}) !important;
          transition: color ui.$transition-fast;
        }

        &:hover :global(.rss-icon),
        &:hover .rss-icon {
          color: var(--rss-accent-hover, #{ui.$rss-accent-hover}) !important;
        }
      }
    }
  }
</style>
