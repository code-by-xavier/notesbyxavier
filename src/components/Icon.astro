---
// File: src/components/Icon.astro
// ============================================================
// Notesby — Unified Vector Icon Component
// Single source of truth for rendering all platform vector icons
// by importing raw SVG assets from src/assets/icons/ with zero runtime overhead.
// ============================================================

import type { IconName } from '@/types/icon';
export type { IconName };

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  color?: string;
  strokeWidth?: number;
  'aria-hidden'?: boolean | 'true' | 'false';
  'aria-label'?: string;
}

const {
  name,
  size = 20,
  class: className = '',
  color,
  strokeWidth = 2,
  'aria-hidden': ariaHidden = true,
  'aria-label': ariaLabel,
} = Astro.props;

// Load all SVGs as raw strings at build-time with Vite's eager glob
const icons = import.meta.glob<string>('/src/assets/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const rawSvg = icons[`/src/assets/icons/${name}.svg`] || '';

let svgHtml = '';
if (rawSvg) {
  const styleAttr = color ? ` style="color: ${color};"` : '';
  const ariaAttr = ariaLabel
    ? ` aria-label="${ariaLabel}"`
    : ariaHidden
      ? ' aria-hidden="true"'
      : '';
  const classAttr = className ? ` class="${className}"` : '';

  // Replace dimensions and attributes on the opening <svg> tag
  svgHtml = rawSvg
    .replace(/\bwidth="[^"]*"/, `width="${size}"`)
    .replace(/\bheight="[^"]*"/, `height="${size}"`)
    .replace(/\bstroke-width="[^"]*"/, `stroke-width="${strokeWidth}"`)
    .replace(/<svg\b([^>]*)>/, `<svg$1${classAttr}${styleAttr}${ariaAttr}>`);
}
---

<Fragment set:html={svgHtml} />
