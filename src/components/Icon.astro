---
// File: src/components/Icon.astro
// ============================================================
// Notesby — Unified Vector Icon Component
// Single source of truth for rendering all platform vector icons
// with strict TypeScript autocompletion and consistent styling.
// ============================================================

import type { IconName } from '@/types/icon';
export type { IconName };

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  color?: string;
  strokeWidth?: number;
  'aria-hidden'?: boolean | 'true' | 'false';
  'aria-label'?: string;
}

const {
  name,
  size = 20,
  class: className = '',
  color,
  strokeWidth = 2,
  'aria-hidden': ariaHidden = true,
  'aria-label': ariaLabel,
} = Astro.props;

const style = color ? `color: ${color};` : undefined;
---

{name === 'arrow-left' && (
  <svg
    class={className}
    style={style}
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden={ariaHidden}
    aria-label={ariaLabel}
  >
    <line x1="19" y1="12" x2="5" y2="12" />
    <polyline points="12 19 5 12 12 5" />
  </svg>
)}

{name === 'chevron-left' && (
  <svg
    class={className}
    style={style}
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden={ariaHidden}
    aria-label={ariaLabel}
  >
    <polyline points="15 18 9 12 15 6" />
  </svg>
)}

