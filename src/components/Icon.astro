// File: src/components/Icon.astro
// ============================================================
// Notesby — Unified Vector Icon Component
// Single source of truth for rendering all platform vector icons
// with strict TypeScript autocompletion and consistent styling.
// ============================================================

import type { IconName } from '@/types/icon';
export type { IconName };

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  color?: string;
  strokeWidth?: number;
  'aria-hidden'?: boolean | 'true' | 'false';
  'aria-label'?: string;
}

const {
  name,
  size = 20,
  class: className = '',
  color,
  strokeWidth = 2,
  'aria-hidden': ariaHidden = true,
  'aria-label': ariaLabel,
} = Astro.props;

const style = color ? `color: ${color};` : undefined;
