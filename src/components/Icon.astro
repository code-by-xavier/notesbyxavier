---
// File: src/components/Icon.astro
// ============================================================
// Notesby — Unified Icon Component
// Single source of truth for rendering all platform vector icons
// with strict TypeScript autocompletion and consistent styling.
// ============================================================

export type IconName = 'arrow-left' | 'chevron-left' | 'chevron-right' | 'rss';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
  'aria-hidden'?: boolean | 'true' | 'false';
  'aria-label'?: string;
}

const {
  name,
  size = 20,
  class: className = '',
  strokeWidth = 2,
  'aria-hidden': ariaHidden = true,
  'aria-label': ariaLabel,
} = Astro.props;
---

{name === 'arrow-left' && (
  <svg
    class={className}
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden={ariaHidden}
    aria-label={ariaLabel}
  >
    <line x1="19" y1="12" x2="5" y2="12" />
    <polyline points="12 19 5 12 12 5" />
  </svg>
)}

{name === 'chevron-left' && (
  <svg
    class={className}
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden={ariaHidden}
    aria-label={ariaLabel}
  >
    <polyline points="15 18 9 12 15 6" />
  </svg>
)}

{name === 'chevron-right' && (
  <svg
    class={className}
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden={ariaHidden}
    aria-label={ariaLabel}
  >
    <polyline points="9 18 15 12 9 6" />
  </svg>
)}

{name === 'rss' && (
  <svg
    class={className}
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden={ariaHidden}
    aria-label={ariaLabel}
  >
    <path d="M4 11a9 9 0 0 1 9 9" />
    <path d="M4 4a16 16 0 0 1 16 16" />
    <circle cx="5" cy="19" r="1" />
  </svg>
)}
