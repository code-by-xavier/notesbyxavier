---
// File: src/pages/about.astro
// ============================================================
// Notesby — About Page
// Publication philosophy and platform introduction.
// ============================================================

import BaseLayout from '@/layouts/BaseLayout.astro';
import { notesConfig } from '@config';
import { EXTERNAL_LINKS } from '@/links';
---

<BaseLayout title="About">
  <div class="reading-container about-page">
    <h1 class="about-page__title">About</h1>

    <div class="prose-editorial">
      <p>
        Welcome to <strong>{notesConfig.siteTitle}</strong>. This publication is an open
        intellectual journal dedicated to deep-dive essays on software engineering, technology, and
        architectural thought.
      </p>

      <h2>Philosophy</h2>
      <p>
        Writing clarifies thought. In an age of ephemeral social media feeds and algorithmic noise,
        this site is deliberately crafted as a calm, high-signal reading sanctuary. Inspired by
        classic long-form technical writing and architectural blueprints, each piece here represents
        deliberate, distilled perspective.
      </p>

      <h2>The Platform</h2>
      <p>
        This site is powered by <strong>Notesby</strong>, an open-source static publishing engine
        created under the <strong>CLSTRE</strong> tech ecosystem and designed and developed by{' '}
        <a href={EXTERNAL_LINKS.AUTHOR} target="_blank" rel="noopener noreferrer">
          Xavier Lawrence
        </a>
        . It is completely static, lightning-fast, and built on Astro with zero runtime client
        bloat.
      </p>

      <p>
        You can view or contribute to the open-source codebase on{' '}
        <a
          href={notesConfig.repository || EXTERNAL_LINKS.REPOSITORY}
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
        .
      </p>

      <h2>Connect</h2>
      <p>
        Follow ongoing developments on{' '}
        <a href={notesConfig.socials.twitter} target="_blank" rel="noopener noreferrer">
          X (Twitter)
        </a>{' '}
        or explore sovereign infrastructure on{' '}
        <a href={EXTERNAL_LINKS.CLSTRE} target="_blank" rel="noopener noreferrer">
          CLSTRE
        </a>
        .
      </p>
    </div>
  </div>
</BaseLayout>

<style lang="scss">
  .about-page {
    padding: var(--spacing-5xl, #{ui.$spacing-5xl}) var(--spacing-lg, #{ui.$spacing-lg});

    &__title {
      @include ui.page-heading-style;
      margin-top: 0;
      margin-bottom: var(--spacing-xl, #{ui.$spacing-xl});
      padding-bottom: var(--spacing-lg, #{ui.$spacing-lg});
      border-bottom: var(--border-width-base, #{ui.$border-width-base}) solid
        var(--border-color, #{ui.$border-light});
    }
  }
</style>
