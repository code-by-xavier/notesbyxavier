---
// File: src/pages/projects.astro
// ============================================================
// Notesby — Projects & Systems Architecture Showcase
// Personal portfolio showcase page for Xavier Lawrence.
// ============================================================

import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { projects } from '@/data/projects';
import { notesConfig } from '@config';
---

<BaseLayout
  title="Projects & Architecture"
  description="Systems, platforms, and open-source infrastructure designed and built by Xavier Lawrence."
>
  <div class="projects-page">
    <section class="projects-hero">
      <div class="container">
        <h1 class="projects-hero__title">Projects & Architecture</h1>
        <p class="projects-hero__subtitle">
          Platforms and open-source software designed and built by {notesConfig.authorName}.
        </p>

        <div class="projects-hero__philosophy">
          <span class="philosophy-tag">Architectural Philosophy</span>
          <p>
            "Simplicity is my prerequisite for reliability." The architectures below are
            deliberately built with minimal moving parts, sovereign cloud ownership, and zero
            unnecessary runtime bloat.
          </p>
        </div>
      </div>
    </section>

    <main class="projects-list">
      <div class="container">
        {projects.map((project) => (
          <article class="project-card">
            <header class="project-card__header">
              <div class="project-card__title-meta">
                <div class="project-card__badges">
                  <span
                    class={`status-badge status-badge--${project.status.toLowerCase().replace(/\s+/g, '-')}`}
                  >
                    {project.status}
                  </span>
                  <span class="period-badge">{project.period}</span>
                </div>

                {project.logo && (
                  <div class="project-card__logo-wrap">
                    <img
                      src={project.logo}
                      alt={`${project.title} Logo`}
                      class="project-card__logo project-card__logo--light"
                    />
                    {project.logoDark && (
                      <img
                        src={project.logoDark}
                        alt={`${project.title} Logo`}
                        class="project-card__logo project-card__logo--dark"
                      />
                    )}
                  </div>
                )}

                <h2 class="project-card__title">{project.title}</h2>
                <p class="project-card__role">{project.role}</p>
              </div>

              <div class="project-card__actions">
                {project.deployUrl && (
                  <a
                    href={project.deployUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-btn project-btn--deploy"
                    title="1-Click Launch on Google Cloud"
                  >
                    <Icon name="zap" size={14} />
                    <span>{project.deployLabel || 'Deploy to GCP'}</span>
                  </a>
                )}

                {project.liveUrl && (
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-btn project-btn--primary"
                  >
                    <span>Visit Live</span>
                    <Icon name="external-link" size={14} />
                  </a>
                )}

                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-btn project-btn--secondary"
                  >
                    <span>GitHub</span>
                    <Icon name="github" size={14} />
                  </a>
                )}
              </div>
            </header>

            <p class="project-card__overview">{project.overview}</p>

            <div class="project-card__section">
              <h3 class="section-heading">Tech Stack</h3>
              <div class="tech-stack-pills">
                {project.stack.map((tech) => (
                  <span class="tech-pill">#{tech}</span>
                ))}
              </div>
            </div>

            <div class="project-card__section">
              <h3 class="section-heading">Architecture & System Specs</h3>
              <div class="specs-grid">
                {project.specs.map((spec) => (
                  <div class="spec-item">
                    <span class="spec-item__label">{spec.label}</span>
                    <span class="spec-item__value">{spec.value}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="project-card__why">
              <div class="why-header">
                <Icon name="help-circle" size={16} />
                <span class="why-title">Why Keep It Simple?</span>
              </div>
              <p class="why-body">{project.whyKeepItSimple}</p>
            </div>
          </article>
        ))}
      </div>
    </main>
  </div>
</BaseLayout>

<style lang="scss">
  .projects-page {
    padding-bottom: var(--spacing-6xl, #{ui.$spacing-6xl});
  }

  .projects-hero {
    padding-top: var(--hero-padding-top, #{ui.$hero-padding-top});
    padding-bottom: var(--spacing-xl, #{ui.$spacing-xl});
    border-bottom: var(--border-width-base, #{ui.$border-width-base}) solid
      var(--border-color, #{ui.$border-light});

    .container {
      @include ui.container;
    }

    &__title {
      @include ui.page-heading-style;
      margin-top: 0;
      margin-bottom: var(--spacing-xs, #{ui.$spacing-xs});
    }

    &__subtitle {
      @include ui.page-paragraph-style;
      font-size: var(--font-size-md, #{ui.$font-size-md});
      line-height: var(--line-height-base, #{ui.$line-height-base});
      max-width: var(--hero-bio-max-width, #{ui.$hero-bio-max-width});
      margin-bottom: var(--spacing-lg, #{ui.$spacing-lg});
    }

    &__philosophy {
      background-color: var(--surface-color, #{ui.$surface-light});
      border: var(--border-width-base, #{ui.$border-width-base}) solid
        var(--border-color, #{ui.$border-light});
      border-radius: var(--border-radius-md, #{ui.$border-radius-md});
      padding: var(--spacing-unit, #{ui.$spacing-unit})
        var(--spacing-md-plus, #{ui.$spacing-md-plus});
      max-width: var(--container-max-width, #{ui.$container-max-width});

      .philosophy-tag {
        display: inline-block;
        font-family: var(--font-family-base, #{ui.$font-family-base});
        font-size: var(--font-size-2xs, #{ui.$font-size-2xs});
        font-weight: ui.$font-weight-semibold;
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-meta, #{ui.$letter-spacing-meta});
        color: var(--accent-color, #{ui.$primary-accent});
        margin-bottom: var(--spacing-3xs, #{ui.$spacing-3xs});
      }

      p {
        @include ui.subtitle-serif-style(subhead);
        margin: 0;
      }
    }
  }

  .projects-list {
    padding-top: var(--spacing-xl, #{ui.$spacing-xl});

    .container {
      @include ui.container;
      display: flex;
      flex-direction: column;
      gap: var(--page-section-gap, #{ui.$page-section-gap});
    }
  }

  .project-card {
    @include ui.card-surface-style;
    padding: var(--card-padding-y, #{ui.$card-padding-y})
      var(--card-padding-x, #{ui.$card-padding-x});

    @include ui.media-breakpoint-down(sm) {
      padding: var(--spacing-unit, #{ui.$spacing-unit});
    }

    &__header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: var(--spacing-unit, #{ui.$spacing-unit});
      margin-bottom: var(--spacing-unit, #{ui.$spacing-unit});
      flex-wrap: wrap;
    }

    &__title-meta {
      flex: 1;
      min-width: 260px;
    }

    &__badges {
      display: flex;
      align-items: center;
      gap: var(--spacing-xs, #{ui.$spacing-xs});
      margin-bottom: var(--spacing-xs, #{ui.$spacing-xs});
    }

    .status-badge {
      @include ui.badge-pill-style;

      &--production {
        background-color: rgba(34, 197, 94, 0.12);
        color: #22c55e;
        border-color: rgba(34, 197, 94, 0.25);
      }

      &--open-source,
      &--active {
        background-color: var(--accent-light, #{ui.$primary-accent-light});
        color: var(--accent-color, #{ui.$primary-accent});
        border-color: rgba(7, 90, 170, 0.25);
      }
    }

    .period-badge {
      @include ui.meta-text-style(xs);
    }

    &__logo-wrap {
      display: block;
      margin-top: var(--spacing-unit, #{ui.$spacing-unit});
      margin-bottom: var(--spacing-sm, #{ui.$spacing-sm});
      line-height: 1;
    }

    &__logo {
      display: block;
      height: 28px;
      width: auto;

      &--dark {
        display: none;
      }
    }

    :global([data-theme='dark']) & &__logo {
      &--light {
        display: none;
      }
      &--dark {
        display: block;
      }
    }

    &__title {
      @include ui.h2-heading-style;
      margin-top: 0;
      margin-bottom: var(--spacing-3xs, #{ui.$spacing-3xs});
    }

    &__role {
      @include ui.meta-text-style(sm);
      margin: 0;
    }

    &__actions {
      display: flex;
      align-items: center;
      gap: var(--spacing-xs, #{ui.$spacing-xs});
      flex-wrap: wrap;
    }

    .project-btn {
      @include ui.button-base;
      font-size: var(--font-size-footer, #{ui.$font-size-footer});
      padding: var(--spacing-2xs, #{ui.$spacing-2xs}) var(--spacing-sm, #{ui.$spacing-sm});
      border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});

      &--deploy {
        background-color: var(--accent-color, #{ui.$primary-accent});
        color: #ffffff;
        border-color: var(--accent-color, #{ui.$primary-accent});

        &:hover {
          background-color: var(--accent-hover, #{ui.$primary-accent-hover});
          border-color: var(--accent-hover, #{ui.$primary-accent-hover});
        }
      }

      &--primary {
        background-color: var(--surface-color, #{ui.$surface-light});
        color: var(--accent-color, #{ui.$primary-accent});
        border-color: var(--accent-color, #{ui.$primary-accent});

        &:hover {
          background-color: var(--accent-light, #{ui.$primary-accent-light});
        }
      }

      &--secondary {
        background-color: var(--bg-color, #{ui.$bg-light});
        color: var(--text-secondary, #{ui.$text-secondary-light});
        border-color: var(--border-color, #{ui.$border-light});

        &:hover {
          color: var(--text-primary, #{ui.$text-primary-light});
          border-color: var(--text-secondary, #{ui.$text-secondary-light});
        }
      }
    }

    &__overview {
      @include ui.page-paragraph-style;
      font-size: var(--font-size-base, #{ui.$font-size-base});
      line-height: var(--line-height-base, #{ui.$line-height-base});
      margin: 0 0 var(--spacing-unit, #{ui.$spacing-unit});
    }

    &__section {
      margin-bottom: var(--spacing-unit, #{ui.$spacing-unit});

      .section-heading {
        @include ui.meta-text-style(xs);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-meta, #{ui.$letter-spacing-meta});
        margin-bottom: var(--spacing-xs, #{ui.$spacing-xs});
      }
    }

    .tech-stack-pills {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-xs, #{ui.$spacing-xs});

      .tech-pill {
        @include ui.tag-pill-style;
      }
    }

    .specs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--spacing-xs, #{ui.$spacing-xs});

      .spec-item {
        background-color: var(--bg-color, #{ui.$bg-light});
        border: var(--border-width-base, #{ui.$border-width-base}) solid
          var(--border-subtle, #{ui.$border-subtle-light});
        border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});
        padding: var(--spacing-xs, #{ui.$spacing-xs}) var(--spacing-unit, #{ui.$spacing-unit});
        display: flex;
        flex-direction: column;
        gap: var(--spacing-3xs, #{ui.$spacing-3xs});

        &__label {
          @include ui.meta-text-style(xs);
          text-transform: uppercase;
        }

        &__value {
          font-family: var(--font-family-base, #{ui.$font-family-base});
          font-size: var(--font-size-sm, #{ui.$font-size-sm});
          color: var(--text-primary, #{ui.$text-primary-light});
          line-height: 1.4;
        }
      }
    }

    &__why {
      background-color: var(--bg-color, #{ui.$bg-light});
      border-left: var(--border-width-thick, #{ui.$border-width-thick}) solid
        var(--accent-color, #{ui.$primary-accent});
      border-radius: 0 var(--border-radius-sm, #{ui.$border-radius-sm})
        var(--border-radius-sm, #{ui.$border-radius-sm}) 0;
      padding: var(--spacing-unit, #{ui.$spacing-unit}) var(--spacing-md, #{ui.$spacing-md});
      margin-top: var(--spacing-unit, #{ui.$spacing-unit});

      .why-header {
        display: flex;
        align-items: center;
        gap: var(--spacing-xs, #{ui.$spacing-xs});
        color: var(--accent-color, #{ui.$primary-accent});
        margin-bottom: var(--spacing-3xs, #{ui.$spacing-3xs});

        .why-title {
          font-family: var(--font-family-base, #{ui.$font-family-base});
          font-size: var(--font-size-footer, #{ui.$font-size-footer});
          font-weight: ui.$font-weight-semibold;
          letter-spacing: var(--letter-spacing-tight, #{ui.$letter-spacing-tight});
        }
      }

      .why-body {
        font-family: var(--font-family-base, #{ui.$font-family-base});
        font-size: var(--font-size-sm, #{ui.$font-size-sm});
        color: var(--text-secondary, #{ui.$text-secondary-light});
        line-height: 1.55;
        margin: 0;
      }
    }
  }
</style>
