---
// File: src/pages/admin/setup.astro
// ============================================================
// Notesby — Premium 5-Step Guided Setup Wizard
// First-run sovereign cloud onboarding experience.
// Modular architecture: subcomponents in src/components/setup/
// Styles in src/styles/components/_setup.scss
// Client logic in src/components/setup/setup-client.ts
// ============================================================

import BaseLayout from '@/layouts/BaseLayout.astro';
import { isSetupCompleted } from '@/lib/auth';
import { ROUTES } from '@/links';

import SetupStepper from '@/components/setup/SetupStepper.astro';
import SetupStepConnection from '@/components/setup/SetupStepConnection.astro';
import SetupStepIdentity from '@/components/setup/SetupStepIdentity.astro';
import SetupStepAccount from '@/components/setup/SetupStepAccount.astro';
import SetupStepBranding from '@/components/setup/SetupStepBranding.astro';
import SetupStepLaunch from '@/components/setup/SetupStepLaunch.astro';

export const prerender = false;

const alreadySetup = await isSetupCompleted();
if (alreadySetup) {
  return Astro.redirect(ROUTES.ADMIN.LOGIN);
}
---

<BaseLayout title="Setup Your Publication — Notesby" hideNav={true} hideFooter={true}>
  <div class="setup-root" id="setup-root">
    <!-- Background gradient canvas -->
    <div class="setup-bg" aria-hidden="true">
      <div class="setup-bg__orb setup-bg__orb--1"></div>
      <div class="setup-bg__orb setup-bg__orb--2"></div>
    </div>

    <!-- Main centered container -->
    <div class="setup-shell">
      <!-- Brand wordmark -->
      <a href={ROUTES.HOME} class="setup-brand" aria-label="Notesby Home">
        <img src="/images/notesby-logo-light.png" alt="Notesby" class="setup-brand__logo" />
      </a>

      <!-- Top progress stepper -->
      <SetupStepper />

      <!-- Step panels -->
      <div class="step-container">
        <SetupStepConnection />
        <SetupStepIdentity />
        <SetupStepAccount />
        <SetupStepBranding />
        <SetupStepLaunch />
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import '@/components/setup/setup-client';
</script>

<style is:global lang="scss">
  @use '@/styles/components/setup';
</style>
