---
// File: src/pages/admin/setup.astro
// ============================================================
// Notesby — Publication Onboarding Setup Wizard
// First-run setup screen to claim the publication and create the admin.
// Utilizes reusable UI form primitives with seamless canvas aesthetics.
// ============================================================

import BaseLayout from '@/layouts/BaseLayout.astro';
import FormField from '@/components/ui/FormField.astro';
import Input from '@/components/ui/Input.astro';
import Button from '@/components/ui/Button.astro';
import FormError from '@/components/ui/FormError.astro';
import HelperText from '@/components/ui/HelperText.astro';
import LegalNotice from '@/components/ui/LegalNotice.astro';
import { isSetupCompleted } from '@/lib/auth';
import { ROUTES } from '@/links';

export const prerender = false;

const alreadySetup = await isSetupCompleted();
if (alreadySetup) {
  return Astro.redirect(ROUTES.ADMIN.LOGIN);
}
---

<BaseLayout title="Setup Your Publication — Notesby" hideNav={true} hideFooter={true}>
  <div class="auth-wrapper">
    <div class="auth-card">
      <header class="auth-card__header">
        <a href={ROUTES.HOME} class="auth-brand" aria-label="Notesby Home">
          <span class="auth-brand__mark">N</span>
          <span class="auth-brand__name">Notesby</span>
        </a>
        <h1 class="auth-card__title">Claim Your Publication</h1>
        <p class="auth-card__subtitle">
          Configure your master administrator account and publication identity.
        </p>
      </header>

      <form id="setup-form" class="auth-form" novalidate>
        <FormError id="error-message" />

        <FormField
          label="Publication Title"
          forId="siteTitle"
          required={true}
          helperText="The title displayed across your publication header and RSS feeds."
        >
          <Input
            type="text"
            id="siteTitle"
            name="siteTitle"
            placeholder="e.g. Xavier's Notes"
            required={true}
            autocomplete="organization"
          />
        </FormField>

        <FormField
          label="Your Full Name"
          forId="authorName"
          required={true}
          helperText="Displayed on essay bylines and author profile."
        >
          <Input
            type="text"
            id="authorName"
            name="authorName"
            placeholder="e.g. Xavier Lawrence"
            required={true}
            autocomplete="name"
          />
        </FormField>

        <FormField
          label="Admin Email Address"
          forId="email"
          required={true}
          helperText="Your sovereign master credential used for logging into Studio."
        >
          <Input
            type="email"
            id="email"
            name="email"
            placeholder="you@example.com"
            required={true}
            autocomplete="email"
          />
        </FormField>

        <FormField
          label="Master Password"
          forId="password"
          required={true}
          helperText="At least 8 characters. Hashed with bcrypt before storage."
        >
          <Input
            type="password"
            id="password"
            name="password"
            placeholder="At least 8 characters"
            required={true}
            minlength={8}
            autocomplete="new-password"
          />
        </FormField>

        <FormField label="Confirm Password" forId="confirmPassword" required={true}>
          <Input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            placeholder="Repeat your password"
            required={true}
            minlength={8}
            autocomplete="new-password"
          />
        </FormField>

        <Button
          type="submit"
          id="submit-btn"
          variant="primary"
          size="md"
          block={true}
          loadingText="Initializing..."
        >
          Complete Setup & Launch
        </Button>

        <LegalNotice actionText="completing setup" />
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('setup-form') as HTMLFormElement | null;
  const errorBox = document.getElementById('error-message') as HTMLDivElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = submitBtn?.querySelector('.ui-button__text') as HTMLElement | null;
  const btnSpinner = submitBtn?.querySelector('.ui-button__spinner') as HTMLElement | null;

  function showError(msg: string) {
    if (!errorBox) return;
    const msgEl = errorBox.querySelector('.ui-form-error__message');
    if (msgEl) {
      msgEl.textContent = msg;
    } else {
      errorBox.textContent = msg;
    }
    errorBox.style.display = 'flex';
  }

  function hideError() {
    if (!errorBox) return;
    errorBox.style.display = 'none';
  }

  function setLoading(loading: boolean) {
    if (!submitBtn || !btnText || !btnSpinner) return;
    submitBtn.disabled = loading;
    btnText.style.display = loading ? 'none' : 'inline';
    btnSpinner.style.display = loading ? 'inline-flex' : 'none';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();

    const siteTitle = (document.getElementById('siteTitle') as HTMLInputElement)?.value.trim();
    const authorName = (document.getElementById('authorName') as HTMLInputElement)?.value.trim();
    const email = (document.getElementById('email') as HTMLInputElement)?.value.trim();
    const password = (document.getElementById('password') as HTMLInputElement)?.value;
    const confirmPassword = (document.getElementById('confirmPassword') as HTMLInputElement)?.value;

    if (!siteTitle || !authorName || !email || !password) {
      showError('Please fill out all required fields.');
      return;
    }

    if (password.length < 8) {
      showError('Password must be at least 8 characters.');
      return;
    }

    if (password !== confirmPassword) {
      showError('Passwords do not match.');
      return;
    }

    setLoading(true);

    try {
      const response = await fetch('/api/auth/setup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ siteTitle, authorName, email, password }),
      });

      const result = await response.json();

      if (!response.ok) {
        showError(result.error || 'Failed to complete setup.');
        setLoading(false);
        return;
      }

      window.location.href = result.redirect || '/admin';
    } catch (err: any) {
      showError('A network error occurred. Please try again.');
      setLoading(false);
    }
  });
</script>

<style lang="scss">
  @use '@/styles/abstracts' as ui;

  .auth-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-2xl, #{ui.$spacing-2xl}) var(--spacing-md, #{ui.$spacing-md});
    background-color: var(--bg-color, #{ui.$bg-light});
  }

  // Seamless form canvas without background card, border, or shadow
  .auth-card {
    width: 100%;
    max-width: 460px;
    padding: var(--spacing-sm, #{ui.$spacing-sm}) 0;

    &__header {
      text-align: center;
      margin-bottom: var(--spacing-lg, #{ui.$spacing-lg});
    }

    &__title {
      @include ui.h2-heading-style;
      margin-top: var(--spacing-sm, #{ui.$spacing-sm});
      margin-bottom: var(--spacing-2xs, #{ui.$spacing-2xs});
    }

    &__subtitle {
      @include ui.description-text;
      margin: 0 auto;
      max-width: 90%;
    }
  }

  .auth-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs, #{ui.$spacing-xs});
    text-decoration: none;
    color: var(--text-primary, #{ui.$text-primary-light});
    font-weight: ui.$font-weight-bold;
    font-size: var(--font-size-lg, #{ui.$font-size-lg});

    &__mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});
      background-color: var(--accent-color, #{ui.$primary-accent});
      color: #ffffff;
      font-size: var(--font-size-sm, #{ui.$font-size-sm});
      font-family: var(--font-family-mono, #{ui.$font-family-mono});
      font-weight: ui.$font-weight-bold;
    }

    &__name {
      font-family: var(--font-family-serif, #{ui.$font-family-serif});
      font-size: var(--font-size-xl, #{ui.$font-size-xl});
    }
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md, #{ui.$spacing-md});
  }
</style>
