---
// File: src/pages/admin/editor/[id].astro
// ============================================================
// Notesby — Notesby Studio True-to-Life Editorial Canvas
// In-browser writing sanctuary with 1:1 reader typography,
// live formatted headings, slash commands, auto-saving drafts,
// and persistent publication state.
// Modular architecture:
// - Header: src/components/editor/EditorHeader.astro
// - Canvas: src/components/editor/EditorCanvas.astro
// - Styles: src/styles/components/_editor.scss
// - Client: src/components/editor/editor-client.ts
// ============================================================

import BaseLayout from '@/layouts/BaseLayout.astro';
import WritingGuideModal from '@/components/WritingGuideModal.astro';
import LinkModal from '@/components/LinkModal.astro';
import EditorHeader from '@/components/editor/EditorHeader.astro';
import EditorCanvas from '@/components/editor/EditorCanvas.astro';
import { getNoteById, parseMarkdown, getAllFeedNotes, listNotesByAuthor } from '@/lib/notes';
import { notesConfig } from '@config';
import { ROUTES } from '@/links';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(ROUTES.ADMIN.LOGIN);
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect(ROUTES.ADMIN.ROOT);
}

const note = await getNoteById(id, user.id);
if (!note) {
  return Astro.redirect(ROUTES.ADMIN.ROOT);
}

const categories = notesConfig.categories?.map((c) => c.name) || [
  'Essays',
  'Op-Eds',
  'Field Notes',
];
const isPublished = note.status === 'published';

// Fetch available internal notes for seamless cross-linking in the Link Modal
const authorNotes = await listNotesByAuthor(user.id);
const allFeedNotes = await getAllFeedNotes();
const noteMap = new Map<string, { slug: string; title: string; category: string }>();
for (const n of allFeedNotes) {
  noteMap.set(n.slug, { slug: n.slug, title: n.title, category: n.category });
}
for (const n of authorNotes) {
  if (n.id !== note.id) {
    noteMap.set(n.slug, { slug: n.slug, title: n.title, category: n.category });
  }
}
const internalNotes = Array.from(noteMap.values());

// Parse stored markdown into rich initial HTML so headings & blocks render bold and true-to-life on load
const { html: initialContentHtml } = parseMarkdown(note.content || '');
---

<BaseLayout
  title={`${note.title || 'Untitled Note'} — Notesby Studio`}
  hideNav={true}
  hideFooter={true}
>
  <div
    class="zen-layout"
    id="zen-editor-root"
    data-note-id={note.id}
    data-initial-status={note.status}
    data-initial-cover-image={note.coverImage || ''}
    data-has-unpublished-changes={note.hasUnpublishedChanges ? 'true' : 'false'}
  >
    <EditorHeader note={note} categories={categories} isPublished={isPublished} />
    <EditorCanvas note={note} initialContentHtml={initialContentHtml} />
  </div>

  <WritingGuideModal />
  <LinkModal notes={internalNotes} />
</BaseLayout>

<script>
  import '@/components/editor/editor-client';
</script>

<style lang="scss">
  @use '@/styles/components/editor';
</style>
