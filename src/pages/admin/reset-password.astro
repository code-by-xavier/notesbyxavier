---
// File: src/pages/admin/reset-password.astro
// ============================================================
// Notesby — Master Password Reset & Emergency Recovery
// ============================================================

import BaseLayout from '@/layouts/BaseLayout.astro';
import { ROUTES } from '@/links';

export const prerender = false;
---

<BaseLayout title="Reset Password — Notesby" hideNav={true} hideFooter={true}>
  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-card__header">
        <a href={ROUTES.HOME} class="auth-brand" aria-label="Notesby Home">
          <span class="auth-brand__mark">N</span>
          <span class="auth-brand__name">Notesby</span>
        </a>
        <h1 class="auth-card__title">Reset Password</h1>
        <p class="auth-card__subtitle">Recover access to your sovereign publication studio.</p>
      </div>

      <div class="rescue-box">
        <h3 class="rescue-box__title">🔑 Sovereign Cloud CLI Recovery</h3>
        <p class="rescue-box__text">
          If your server does not have outbound email configured yet, you can reset your master
          password directly from your terminal or Google Cloud Shell:
        </p>
        <div class="rescue-box__code">
          <code>pnpm run rescue:admin</code>
        </div>
      </div>

      <form id="reset-form" class="auth-form">
        <div id="status-message" class="auth-alert" style="display: none;"></div>

        <div class="auth-form__group">
          <label for="email" class="auth-label">
            Registered Admin Email
          </label>
          <input
            type="email"
            id="email"
            name="email"
            class="auth-input"
            placeholder="publisher@example.com"
            required
            autocomplete="email"
          />
        </div>

        <button type="submit" id="submit-btn" class="auth-btn">
          <span class="auth-btn__text">Send Reset Instructions</span>
          <span class="auth-btn__spinner" style="display: none;">
            Sending...
          </span>
        </button>

        <div class="auth-footer">
          <a href={ROUTES.ADMIN.LOGIN} class="auth-link">
            ← Back to Sign In
          </a>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('reset-form') as HTMLFormElement | null;
  const statusBox = document.getElementById('status-message') as HTMLDivElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!statusBox) return;

    statusBox.className = 'auth-alert auth-alert--info';
    statusBox.textContent =
      'If this email matches an active administrator account, recovery instructions have been dispatched. For self-hosted instances without SMTP, use "pnpm run rescue:admin".';
    statusBox.style.display = 'block';

    if (submitBtn) {
      submitBtn.disabled = true;
    }
  });
</script>

<style lang="scss">
  .auth-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-lg, #{ui.$spacing-lg}) var(--spacing-sm, #{ui.$spacing-sm});
    background-color: var(--bg-color, #{ui.$bg-light});
  }

  .auth-card {
    width: 100%;
    max-width: 460px;
    background-color: var(--surface-color, #{ui.$surface-light});
    border: var(--border-width-base, #{ui.$border-width-base}) solid
      var(--border-color, #{ui.$border-light});
    border-radius: var(--border-radius-lg, #{ui.$border-radius-lg});
    padding: var(--spacing-xl, #{ui.$spacing-xl}) var(--spacing-lg, #{ui.$spacing-lg});
    box-shadow: var(--shadow-md, #{ui.$shadow-md});

    &__header {
      text-align: center;
      margin-bottom: var(--spacing-md, #{ui.$spacing-md});
    }

    &__title {
      @include ui.h2-heading-style;
      margin-top: var(--spacing-sm, #{ui.$spacing-sm});
      margin-bottom: var(--spacing-2xs, #{ui.$spacing-2xs});
    }

    &__subtitle {
      @include ui.description-text;
      margin: 0 auto;
      max-width: 90%;
    }
  }

  .auth-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs, #{ui.$spacing-xs});
    text-decoration: none;
    color: var(--text-primary, #{ui.$text-primary-light});
    font-weight: ui.$font-weight-bold;
    font-size: var(--font-size-lg, #{ui.$font-size-lg});

    &__mark {
      @include ui.flex-center;
      width: 32px;
      height: 32px;
      border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});
      background-color: var(--accent-color, #{ui.$primary-accent});
      color: var(--white, #{ui.$surface-light});
      font-size: var(--font-size-sm, #{ui.$font-size-sm});
      font-family: var(--font-family-mono, #{ui.$font-family-mono});
      font-weight: ui.$font-weight-bold;
    }

    &__name {
      font-family: var(--font-family-serif, #{ui.$font-family-serif});
      font-size: var(--font-size-xl, #{ui.$font-size-xl});
    }
  }

  .rescue-box {
    background-color: var(--bg-color, #{ui.$bg-light});
    border: var(--border-width-base, #{ui.$border-width-base}) solid
      var(--border-subtle, #{ui.$border-subtle-light});
    border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});
    padding: var(--spacing-sm, #{ui.$spacing-sm});
    margin-bottom: var(--spacing-md, #{ui.$spacing-md});

    &__title {
      font-size: var(--font-size-xs, #{ui.$font-size-xs});
      font-weight: ui.$font-weight-semibold;
      text-transform: uppercase;
      letter-spacing: var(--letter-spacing-meta, #{ui.$letter-spacing-meta});
      margin-bottom: var(--spacing-2xs, #{ui.$spacing-2xs});
      color: var(--text-primary, #{ui.$text-primary-light});
    }

    &__text {
      font-size: var(--font-size-xs, #{ui.$font-size-xs});
      color: var(--text-muted, #{ui.$text-muted-light});
      line-height: var(--line-height-normal, #{ui.$line-height-normal});
      margin-bottom: var(--spacing-2xs-plus, #{ui.$spacing-2xs-plus});
    }

    &__code {
      background-color: var(--code-bg, #{ui.$code-bg-light});
      padding: var(--spacing-2xs, #{ui.$spacing-2xs}) var(--spacing-xs, #{ui.$spacing-xs});
      border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});
      font-family: var(--font-family-mono, #{ui.$font-family-mono});
      font-size: var(--font-size-xs, #{ui.$font-size-xs});
      color: var(--accent-color, #{ui.$primary-accent});
      display: inline-block;
    }
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md, #{ui.$spacing-md});

    &__group {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-2xs, #{ui.$spacing-2xs});
    }
  }

  .auth-label {
    font-family: var(--font-family-base, #{ui.$font-family-base});
    font-size: var(--font-size-sm, #{ui.$font-size-sm});
    font-weight: ui.$font-weight-medium;
    color: var(--text-primary, #{ui.$text-primary-light});
  }

  .auth-input {
    width: 100%;
    height: 44px;
    padding: 0 var(--spacing-sm, #{ui.$spacing-sm});
    font-family: var(--font-family-base, #{ui.$font-family-base});
    font-size: var(--font-size-sm, #{ui.$font-size-sm});
    color: var(--text-primary, #{ui.$text-primary-light});
    background-color: var(--bg-color, #{ui.$bg-light});
    border: var(--border-width-base, #{ui.$border-width-base}) solid
      var(--border-color, #{ui.$border-light});
    border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});
    transition:
      border-color ui.$transition-fast,
      box-shadow ui.$transition-fast;

    &:focus {
      outline: none;
      border-color: var(--accent-color, #{ui.$primary-accent});
      box-shadow: 0 0 0 3px rgba(7, 90, 170, 0.15);
    }
  }

  .auth-btn {
    @include ui.flex-center;
    width: 100%;
    height: 46px;
    margin-top: var(--spacing-xs, #{ui.$spacing-xs});
    font-family: var(--font-family-base, #{ui.$font-family-base});
    font-size: var(--font-size-sm, #{ui.$font-size-sm});
    font-weight: ui.$font-weight-semibold;
    color: var(--white, #{ui.$surface-light});
    background-color: var(--accent-color, #{ui.$primary-accent});
    border: none;
    border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});
    cursor: pointer;
    transition:
      background-color ui.$transition-fast,
      transform ui.$transition-fast;

    &:hover:not(:disabled) {
      background-color: var(--accent-hover, #{ui.$primary-accent-hover});
      transform: translateY(-1px);
    }

    &:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  }

  .auth-footer {
    text-align: center;
    margin-top: var(--spacing-xs, #{ui.$spacing-xs});
  }

  .auth-link {
    font-family: var(--font-family-base, #{ui.$font-family-base});
    font-size: var(--font-size-sm, #{ui.$font-size-sm});
    color: var(--accent-color, #{ui.$primary-accent});
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }

  .auth-alert {
    padding: var(--spacing-sm, #{ui.$spacing-sm});
    border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});
    font-size: var(--font-size-xs, #{ui.$font-size-xs});
    line-height: var(--line-height-normal, #{ui.$line-height-normal});

    &--info {
      background-color: rgba(7, 90, 170, 0.08);
      border: var(--border-width-base, #{ui.$border-width-base}) solid rgba(7, 90, 170, 0.25);
      color: var(--text-primary, #{ui.$text-primary-light});
    }
  }
</style>
