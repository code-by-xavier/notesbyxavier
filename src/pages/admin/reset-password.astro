---
// File: src/pages/admin/reset-password.astro
// ============================================================
// Notesby — Admin Password Recovery Screen
// Clean, sovereign password rescue and recovery screen.
// Utilizes reusable UI form primitives with seamless canvas aesthetics.
// ============================================================

import BaseLayout from '@/layouts/BaseLayout.astro';
import FormField from '@/components/ui/FormField.astro';
import Input from '@/components/ui/Input.astro';
import Button from '@/components/ui/Button.astro';
import FormError from '@/components/ui/FormError.astro';
import HelperText from '@/components/ui/HelperText.astro';
import LegalNotice from '@/components/ui/LegalNotice.astro';
import Icon from '@/components/Icon.astro';
import { ROUTES } from '@/links';

export const prerender = false;
---

<BaseLayout title="Reset Password — Notesby" hideNav={true} hideFooter={true}>
  <div class="auth-wrapper">
    <div class="auth-card">
      <header class="auth-card__header">
        <a href={ROUTES.HOME} class="auth-brand" aria-label="Notesby Home">
          <img src="/images/notesby-logo-dark.png" alt="Notesby" class="auth-brand__logo" />
          <span class="auth-brand__name">Notesby</span>
        </a>
        <h1 class="auth-card__title">Recover Studio Access</h1>
        <p class="auth-card__subtitle">
          In a sovereign architecture, you maintain direct authority over your database credentials.
        </p>
      </header>

      <form id="reset-form" class="auth-form" novalidate>
        <FormError id="error-message" />

        <div id="success-message" class="auth-alert auth-alert--success" style="display: none;">
          A recovery dispatch instruction has been generated. Check server console or follow CLI
          rescue below.
        </div>

        <FormField
          label="Administrator Email"
          forId="email"
          required={true}
          helperText="Enter the registered email associated with your sovereign admin account."
        >
          <Input
            type="email"
            id="email"
            name="email"
            placeholder="publisher@example.com"
            required={true}
            autocomplete="email"
          />
        </FormField>

        <Button
          type="submit"
          id="submit-btn"
          variant="primary"
          size="md"
          block={true}
          loadingText="Dispatching..."
        >
          Request Reset Link
        </Button>

        <div class="rescue-box">
          <h2 class="rescue-box__title">Sovereign Terminal Rescue</h2>
          <HelperText variant="muted">
            If email dispatch is unconfigured, reset credentials instantly from your terminal:
          </HelperText>
          <pre class="rescue-box__code"><code>pnpm run rescue:admin &lt;your-email&gt; &lt;new-password&gt;</code></pre>
        </div>

        <div class="auth-card__footer">
          <a href={ROUTES.ADMIN.LOGIN} class="auth-link">
            <Icon name="arrow-left" size={14} />
            <span>Return to Sign In</span>
          </a>
        </div>

        <LegalNotice actionText="requesting recovery" />
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('reset-form') as HTMLFormElement | null;
  const errorBox = document.getElementById('error-message') as HTMLDivElement | null;
  const successBox = document.getElementById('success-message') as HTMLDivElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = submitBtn?.querySelector('.ui-button__text') as HTMLElement | null;
  const btnSpinner = submitBtn?.querySelector('.ui-button__spinner') as HTMLElement | null;

  function showError(msg: string) {
    if (!errorBox) return;
    const msgEl = errorBox.querySelector('.ui-form-error__message');
    if (msgEl) {
      msgEl.textContent = msg;
    } else {
      errorBox.textContent = msg;
    }
    errorBox.style.display = 'flex';
    if (successBox) successBox.style.display = 'none';
  }

  function showSuccess() {
    if (errorBox) errorBox.style.display = 'none';
    if (successBox) successBox.style.display = 'block';
  }

  function setLoading(loading: boolean) {
    if (!submitBtn || !btnText || !btnSpinner) return;
    submitBtn.disabled = loading;
    btnText.style.display = loading ? 'none' : 'inline';
    btnSpinner.style.display = loading ? 'inline-flex' : 'none';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('email') as HTMLInputElement)?.value.trim();

    if (!email) {
      showError('Please enter your administrator email address.');
      return;
    }

    setLoading(true);

    setTimeout(() => {
      setLoading(false);
      showSuccess();
    }, 600);
  });
</script>

<style lang="scss">
  @use '@/styles/abstracts' as ui;

  .auth-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-2xl, #{ui.$spacing-2xl}) var(--spacing-md, #{ui.$spacing-md});
    background-color: var(--bg-color, #{ui.$bg-light});
  }

  // Seamless form canvas without background card, border, or shadow
  .auth-card {
    width: 100%;
    max-width: 460px;
    padding: var(--spacing-sm, #{ui.$spacing-sm}) 0;

    &__header {
      text-align: center;
      margin-bottom: var(--spacing-md, #{ui.$spacing-md});
    }

    &__title {
      @include ui.h2-heading-style;
      margin-top: var(--spacing-sm, #{ui.$spacing-sm});
      margin-bottom: var(--spacing-2xs, #{ui.$spacing-2xs});
    }

    &__subtitle {
      @include ui.description-text;
      margin: 0 auto;
      max-width: 90%;
    }

    &__footer {
      text-align: center;
      margin-top: var(--spacing-xs, #{ui.$spacing-xs});
    }
  }

  .auth-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs, #{ui.$spacing-xs});
    text-decoration: none;
    color: var(--text-primary, #{ui.$text-primary-light});
    font-weight: ui.$font-weight-bold;
    font-size: var(--font-size-lg, #{ui.$font-size-lg});

    &__logo {
      width: 28px;
      height: 28px;
      border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});
      object-fit: contain;
      display: block;
    }

    &__mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});
      background-color: var(--accent-color, #{ui.$primary-accent});
      color: #ffffff;
      font-size: var(--font-size-sm, #{ui.$font-size-sm});
      font-family: var(--font-family-mono, #{ui.$font-family-mono});
      font-weight: ui.$font-weight-bold;
    }

    &__name {
      font-family: var(--font-family-serif, #{ui.$font-family-serif});
      font-size: var(--font-size-xl, #{ui.$font-size-xl});
    }
  }

  .rescue-box {
    background-color: var(--surface-color, #{ui.$surface-light});
    border: var(--border-width-base, #{ui.$border-width-base}) solid
      var(--border-subtle, #{ui.$border-subtle-light});
    border-radius: var(--border-radius-md, #{ui.$border-radius-md});
    padding: var(--spacing-md, #{ui.$spacing-md});
    margin-top: var(--spacing-xs, #{ui.$spacing-xs});

    &__title {
      font-family: var(--font-family-base, #{ui.$font-family-base});
      font-size: var(--font-size-sm, #{ui.$font-size-sm});
      font-weight: ui.$font-weight-semibold;
      color: var(--text-primary, #{ui.$text-primary-light});
      margin: 0 0 var(--spacing-2xs, #{ui.$spacing-2xs}) 0;
    }

    &__code {
      margin: var(--spacing-xs, #{ui.$spacing-xs}) 0 0 0;
      padding: var(--spacing-xs, #{ui.$spacing-xs}) var(--spacing-sm, #{ui.$spacing-sm});
      background-color: var(--code-bg, #{ui.$code-bg-light});
      border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});
      font-family: var(--font-family-mono, #{ui.$font-family-mono});
      font-size: var(--font-size-xs, #{ui.$font-size-xs});
      color: var(--accent-color, #{ui.$primary-accent});
      overflow-x: auto;
    }
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md, #{ui.$spacing-md});
  }

  .auth-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2xs, #{ui.$spacing-2xs});
    font-family: var(--font-family-base, #{ui.$font-family-base});
    font-size: var(--font-size-sm, #{ui.$font-size-sm});
    color: var(--accent-color, #{ui.$primary-accent});
    text-decoration: none;
    transition: color ui.$transition-fast;

    &:hover {
      text-decoration: underline;
    }
  }

  .auth-alert {
    padding: var(--spacing-sm, #{ui.$spacing-sm}) var(--spacing-md, #{ui.$spacing-md});
    border-radius: var(--border-radius-md, #{ui.$border-radius-md});
    font-size: var(--font-size-sm, #{ui.$font-size-sm});

    &--success {
      background-color: rgba(16, 185, 129, 0.08);
      border: var(--border-width-base, #{ui.$border-width-base}) solid rgba(16, 185, 129, 0.35);
      color: var(--success-color, #{ui.$success-color});
    }
  }
</style>
