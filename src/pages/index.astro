---
// File: src/pages/index.astro
// ============================================================
// Notesby — Home Page
// ============================================================

import BaseLayout from '@/layouts/BaseLayout.astro';
import CategorySlider from '@/components/CategorySlider.astro';
import SubscribeSection from '@/components/SubscribeSection.astro';
import { getAllFeedNotes } from '@/lib/notes';
import { notesConfig } from '@config';
import { getSiteSettings } from '@/lib/settings';

export const prerender = false;

const settings = await getSiteSettings();
const sortedNotes = await getAllFeedNotes();

// Group notes by category
const categoryMap = new Map<string, typeof sortedNotes>();

sortedNotes.forEach((note) => {
  const cat = note.category || 'Essays';
  if (!categoryMap.has(cat)) {
    categoryMap.set(cat, []);
  }
  categoryMap.get(cat)!.push(note);
});

// Build ordered categories
const configCategories = notesConfig.categories || [
  { name: 'Essays', description: 'Long-form pieces and in-depth explorations.' },
  { name: 'Op-Eds', description: 'Commentary, critiques, and opinion pieces.' },
  { name: 'Field Notes', description: 'Working logs, brief thoughts, and dispatches.' },
];

const orderedCategories: {
  name: string;
  description?: string;
  notes: typeof sortedNotes;
}[] = [];

// 1. Add categories configured in notesConfig
configCategories.forEach((cat) => {
  const notes = categoryMap.get(cat.name) || [];
  orderedCategories.push({
    name: cat.name,
    description: cat.description,
    notes,
  });
  categoryMap.delete(cat.name);
});

// 2. Add any other dynamic categories from the database
categoryMap.forEach((notes, catName) => {
  orderedCategories.push({
    name: catName,
    notes,
  });
});
---

<BaseLayout>
  <section class="home-hero">
    <div class="home-hero__container">
      <h1 class="home-hero__title">{settings.siteTitle}</h1>
      <p class="home-hero__bio">{settings.authorBio}</p>
    </div>
  </section>

  <main class="notes-feed">
    <div class="notes-feed__container">
      {orderedCategories.map((cat) => (
        <CategorySlider title={cat.name} description={cat.description} notes={cat.notes} />
      ))}
    </div>
  </main>

  <SubscribeSection settings={settings} />
</BaseLayout>

<style lang="scss">
  .home-hero {
    padding: var(--hero-padding-top, #{ui.$hero-padding-top}) 0
      var(--hero-padding-bottom, #{ui.$hero-padding-bottom});
    border-bottom: var(--border-width-base, #{ui.$border-width-base}) solid
      var(--border-color, #{ui.$border-light});

    &__container {
      @include ui.container;
    }

    &__title {
      @include ui.page-heading-style;
      margin-top: 0;
      margin-bottom: var(--spacing-xs, #{ui.$spacing-xs});

      @include ui.media-breakpoint-down(sm) {
        font-size: var(--font-size-5xl, #{ui.$font-size-5xl});
      }
    }

    &__bio {
      @include ui.page-paragraph-style;
      font-size: var(--font-size-md, #{ui.$font-size-md});
      line-height: var(--line-height-base, #{ui.$line-height-base});
      max-width: var(--hero-bio-max-width, #{ui.$hero-bio-max-width});
      margin-bottom: 0;
    }
  }

  .notes-feed {
    padding: var(--feed-padding-top, #{ui.$feed-padding-top}) 0
      var(--feed-padding-bottom, #{ui.$feed-padding-bottom});

    &__container {
      @include ui.container;
    }
  }
</style>
