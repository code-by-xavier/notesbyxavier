---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import { getCollection } from 'astro:content';
import { notesConfig } from '../../notes.config';

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const sortedNotes = allNotes.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<BaseLayout>
  <section class="home-hero">
    <div class="container home-hero__container">
      <h1 class="home-hero__title">{notesConfig.siteTitle}</h1>
      <p class="home-hero__bio">{notesConfig.authorBio}</p>
    </div>
  </section>

  <section class="notes-feed">
    <div class="container notes-feed__container">
      <div class="notes-grid">
        {
          sortedNotes.map((note) => (
            <NoteCard
              title={note.data.title}
              subtitle={note.data.subtitle}
              description={note.data.description}
              slug={note.id.replace(/\.(md|mdx)$/, '')}
              pubDate={note.data.pubDate}
              tags={note.data.tags}
              readingTime="10 min read"
              coverImage={note.data.coverImage}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .home-hero {
    padding: 3.5rem 0 2.25rem;
    border-bottom: 1px solid var(--border-color);

    &__container {
      max-width: var(--container-max-width);
    }

    &__title {
      font-family: var(--font-family-headings);
      font-size: 2.75rem;
      font-weight: 600;
      letter-spacing: -0.03em;
      color: var(--text-primary);
      margin-bottom: 0.5rem;

      @media (max-width: 640px) {
        font-size: 2.15rem;
      }
    }

    &__bio {
      font-family: var(--font-family-base);
      font-size: 1.05rem;
      color: var(--text-secondary);
      line-height: 1.55;
      max-width: 720px;
    }
  }

  .notes-feed {
    padding: 2.5rem 0 4.5rem;

    &__container {
      max-width: var(--container-max-width);
    }
  }

  // 3 or 4 Column Responsive Grid
  // Keeps cards wide and horizontal (landscape aspect ratio)
  .notes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;

    @media (min-width: 640px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (min-width: 1024px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
