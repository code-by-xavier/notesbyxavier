---
// File: src/pages/subscribe/confirmed.astro
// ============================================================
// Notesby — Email Subscription Confirmation Page
// GTM-trackable unique URL. Shows social links from siteSettings.
// ============================================================

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteSettings } from '@/lib/settings';
import { ROUTES } from '@/links';

export const prerender = false;

const settings = await getSiteSettings();

// Build social link cards — only render configured links
const socialLinks: { label: string; sublabel: string; href: string; icon: string }[] = [];

if (settings.twitterUrl) {
  socialLinks.push({
    label: 'Follow on X',
    sublabel: 'Join the conversation',
    href: settings.twitterUrl,
    icon: 'x',
  });
}
if (settings.linkedinUrl) {
  socialLinks.push({
    label: 'Connect on LinkedIn',
    sublabel: 'Professional network',
    href: settings.linkedinUrl,
    icon: 'linkedin',
  });
}
if (settings.githubUrl) {
  socialLinks.push({
    label: 'Follow on GitHub',
    sublabel: 'Open source & projects',
    href: settings.githubUrl,
    icon: 'github',
  });
}
if (settings.contactEmail) {
  socialLinks.push({
    label: 'Send a message',
    sublabel: settings.contactEmail,
    href: `mailto:${settings.contactEmail}`,
    icon: 'mail',
  });
}
---

<BaseLayout
  title={`${settings.subscriptionConfirmedHeadline} — ${settings.siteTitle}`}
  description={settings.subscriptionConfirmedSubtext}
>
  <div class="confirmed-page">
    <div class="confirmed-page__container">
      <!-- Checkmark Icon -->
      <div class="confirmed-page__icon" aria-hidden="true">
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>

      <div class="confirmed-page__badge">SUBSCRIPTION CONFIRMED</div>

      <h1 class="confirmed-page__headline">{settings.subscriptionConfirmedHeadline}</h1>
      <p class="confirmed-page__subtext">{settings.subscriptionConfirmedSubtext}</p>

      {socialLinks.length > 0 && (
        <div class="confirmed-social">
          <p class="confirmed-social__label">While you're here — follow along:</p>
          <div class="confirmed-social__grid">
            {socialLinks.map((link) => (
              <a
                href={link.href}
                class="confirmed-social__card"
                target={link.href.startsWith('mailto') ? undefined : '_blank'}
                rel={link.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
              >
                <span class="confirmed-social__card-icon" aria-hidden="true">
                  {link.icon === 'x' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                    </svg>
                  )}
                  {link.icon === 'linkedin' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                  )}
                  {link.icon === 'github' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                    </svg>
                  )}
                  {link.icon === 'mail' && (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                  )}
                </span>
                <span class="confirmed-social__card-content">
                  <span class="confirmed-social__card-label">{link.label}</span>
                  <span class="confirmed-social__card-sub">{link.sublabel}</span>
                </span>
                <span class="confirmed-social__card-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      <a href={ROUTES.HOME} class="confirmed-page__back">
        ← Back to reading
      </a>
    </div>
  </div>
</BaseLayout>

<style lang="scss">
  .confirmed-page {
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding: var(--spacing-5xl, #{ui.$spacing-5xl}) 0;

    &__container {
      @include ui.container;
      max-width: 600px;
      text-align: center;
    }

    &__icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: rgba(7, 90, 170, 0.1);
      color: var(--accent-color, #{ui.$primary-accent});
      margin: 0 auto var(--spacing-lg, #{ui.$spacing-lg});
      border: 2px solid rgba(7, 90, 170, 0.2);
    }

    &__badge {
      font-family: var(--font-family-base, #{ui.$font-family-base});
      font-size: var(--font-size-xs, #{ui.$font-size-xs});
      font-weight: ui.$font-weight-medium;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--accent-color, #{ui.$primary-accent});
      margin-bottom: var(--spacing-sm, #{ui.$spacing-sm});
    }

    &__headline {
      font-family: var(--font-family-headings, #{ui.$font-family-headings});
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: ui.$font-weight-semibold;
      color: var(--text-primary, #{ui.$text-primary-light});
      margin: 0 0 var(--spacing-md, #{ui.$spacing-md}) 0;
      letter-spacing: var(--letter-spacing-heading-lg, #{ui.$letter-spacing-heading-lg});
    }

    &__subtext {
      @include ui.description-text;
      font-size: var(--font-size-md, #{ui.$font-size-md});
      line-height: var(--line-height-prose, #{ui.$line-height-prose});
      margin: 0 0 var(--spacing-3xl, #{ui.$spacing-3xl}) 0;
    }

    &__back {
      display: inline-block;
      margin-top: var(--spacing-3xl, #{ui.$spacing-3xl});
      font-family: var(--font-family-base, #{ui.$font-family-base});
      font-size: var(--font-size-sm, #{ui.$font-size-sm});
      font-weight: ui.$font-weight-medium;
      color: var(--accent-color, #{ui.$primary-accent});
      text-decoration: none;
      transition: color ui.$transition-fast;

      &:hover {
        text-decoration: underline;
        color: var(--accent-hover, #{ui.$primary-accent-hover});
      }
    }
  }

  // Social link cards
  .confirmed-social {
    &__label {
      font-family: var(--font-family-base, #{ui.$font-family-base});
      font-size: var(--font-size-sm, #{ui.$font-size-sm});
      color: var(--text-muted, #{ui.$text-muted-light});
      margin-bottom: var(--spacing-lg, #{ui.$spacing-lg});
    }

    &__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--spacing-sm, #{ui.$spacing-sm});
      text-align: left;

      @include ui.media-breakpoint-up(sm) {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    &__card {
      display: flex;
      align-items: center;
      gap: var(--spacing-md, #{ui.$spacing-md});
      padding: var(--spacing-md, #{ui.$spacing-md}) var(--spacing-lg, #{ui.$spacing-lg});
      background: var(--bg-secondary, #{ui.$bg-secondary-light});
      border: var(--border-width-base, #{ui.$border-width-base}) solid
        var(--border-color, #{ui.$border-light});
      border-radius: var(--border-radius-md, #{ui.$border-radius-md});
      text-decoration: none;
      transition:
        border-color ui.$transition-fast,
        background ui.$transition-fast,
        transform ui.$transition-fast;

      &:hover {
        border-color: var(--accent-color, #{ui.$primary-accent});
        background: var(--bg-hover, rgba(7, 90, 170, 0.04));
        transform: translateY(-1px);
      }
    }

    &__card-icon {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: var(--border-radius-sm, #{ui.$border-radius-sm});
      background: var(--bg-tertiary, #{ui.$bg-primary-light});
      color: var(--text-primary, #{ui.$text-primary-light});
      border: var(--border-width-base, #{ui.$border-width-base}) solid
        var(--border-color, #{ui.$border-light});
    }

    &__card-content {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    &__card-label {
      font-family: var(--font-family-base, #{ui.$font-family-base});
      font-size: var(--font-size-sm, #{ui.$font-size-sm});
      font-weight: ui.$font-weight-medium;
      color: var(--text-primary, #{ui.$text-primary-light});
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    &__card-sub {
      font-size: var(--font-size-xs, #{ui.$font-size-xs});
      color: var(--text-muted, #{ui.$text-muted-light});
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    &__card-arrow {
      flex-shrink: 0;
      font-size: var(--font-size-sm, #{ui.$font-size-sm});
      color: var(--text-muted, #{ui.$text-muted-light});
      transition:
        transform ui.$transition-fast,
        color ui.$transition-fast;

      .confirmed-social__card:hover & {
        transform: translateX(3px);
        color: var(--accent-color, #{ui.$primary-accent});
      }
    }
  }
</style>
