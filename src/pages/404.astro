---
// File: src/pages/404.astro
// ============================================================
// Notesby — 404 Page Not Found
// ============================================================

import BaseLayout from '@/layouts/BaseLayout.astro';
import { ROUTES } from '@/links';
---

<BaseLayout title="404 — Page Not Found">
  <div class="reading-container not-found-page">
    <span class="not-found-page__code">404</span>
    <h1 class="not-found-page__title">Note Not Found</h1>
    <p class="not-found-page__message">
      The essay or page you are looking for does not exist, has been moved, or is still being
      drafted.
    </p>
    <div class="not-found-page__actions">
      <a href={ROUTES.HOME} class="not-found-page__button">
        ← Return to all notes
      </a>
    </div>
  </div>
</BaseLayout>

<style lang="scss">
  .not-found-page {
    padding: var(--spacing-7xl, #{ui.$spacing-7xl}) var(--spacing-lg, #{ui.$spacing-lg})
      var(--spacing-8xl, #{ui.$spacing-8xl});
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;

    &__code {
      font-family: var(--font-family-mono, #{ui.$font-family-mono});
      font-size: var(--font-size-sm, #{ui.$font-size-sm});
      font-weight: ui.$font-weight-medium;
      color: var(--accent-color, #{ui.$primary-accent});
      letter-spacing: var(--letter-spacing-mono, #{ui.$letter-spacing-mono});
      margin-bottom: var(--spacing-unit, #{ui.$spacing-unit});
      padding: var(--spacing-2xs, #{ui.$spacing-2xs}) var(--spacing-sm, #{ui.$spacing-sm});
      background-color: var(--tag-bg, #{ui.$tag-bg-light});
      border-radius: var(--border-radius-full, #{ui.$border-radius-full});
    }

    &__title {
      @include ui.page-heading-style;
      margin-top: 0;
      margin-bottom: var(--spacing-unit, #{ui.$spacing-unit});
    }

    &__message {
      @include ui.description-text;
      font-size: var(--font-size-lg, #{ui.$font-size-lg});
      max-width: var(--reading-narrow-width, #{ui.$reading-narrow-width});
      margin-bottom: var(--hero-padding-bottom, #{ui.$hero-padding-bottom});
    }

    &__actions {
      display: flex;
      justify-content: center;
    }

    &__button {
      @include ui.button-base;
      color: var(--surface-color, #{ui.$surface-light});
      background-color: var(--text-primary, #{ui.$text-primary-light});
      border-radius: var(--border-radius-md, #{ui.$border-radius-md});
      transition:
        opacity ui.$transition-fast,
        transform ui.$transition-fast;

      &:hover {
        opacity: 0.88;
        transform: translateY(calc(-1 * var(--border-width-base, #{ui.$border-width-base})));
      }
    }
  }
</style>
