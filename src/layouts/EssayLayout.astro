---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { HeadingItem } from '../components/TableOfContents.astro';
import { notesConfig } from '../../notes.config';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  pubDate: Date | string;
  updatedDate?: Date | string;
  headings: HeadingItem[];
  coverImage?: string;
  coverImageAlt?: string;
  readingTime?: string;
}

const {
  title,
  subtitle,
  description,
  pubDate,
  updatedDate,
  headings = [],
  coverImage,
  coverImageAlt,
  readingTime = '10 min read',
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
}).format(new Date(pubDate));
---

<BaseLayout
  title={title}
  description={description}
  isEssay={true}
  pubDate={pubDate}
  updatedDate={updatedDate}
  image={coverImage}
>
  <div class="essay-layout">
    <div class="container essay-layout__container">
      <!-- Left Sidebar: Contents TOC -->
      <TableOfContents headings={headings} />

      <!-- Main Reading Column -->
      <article class="essay-main">
        <header class="essay-header">
          <h1 class="essay-header__title">{title}</h1>
          {subtitle && <p class="essay-header__subtitle">{subtitle}</p>}
          <div class="essay-header__meta">
            <time datetime={new Date(pubDate).toISOString()}>{formattedDate}</time>
            <span class="essay-header__dot">·</span>
            <span>{readingTime}</span>
          </div>
        </header>

        <!-- Optional Header Cover Image -->
        {
          coverImage && (
            <figure class="essay-cover">
              <img src={coverImage} alt={coverImageAlt || title} class="essay-cover__img" />
              {coverImageAlt && (
                <figcaption class="essay-cover__caption">{coverImageAlt}</figcaption>
              )}
            </figure>
          )
        }

        <div class="prose-editorial essay-content">
          <slot />
        </div>

        <!-- Footnote / Author Sign-off -->
        <footer class="essay-footer">
          <div class="essay-footer__author">
            <div class="essay-footer__author-name">{notesConfig.authorName}</div>
            <p class="essay-footer__author-bio">{notesConfig.authorBio}</p>
          </div>
          <div class="essay-footer__actions">
            <a href="/" class="essay-footer__back-link">← Read all notes</a>
            <a href="/rss.xml" class="essay-footer__rss-link">RSS Feed</a>
          </div>
        </footer>
      </article>
    </div>
  </div>
</BaseLayout>

<style lang="scss">
  .essay-layout {
    padding-top: 2.5rem;

    &__container {
      display: flex;
      justify-content: center;
      gap: 3.5rem;
      position: relative;
    }
  }

  .essay-main {
    width: 100%;
    max-width: var(--reading-max-width);
    min-width: 0;
  }

    .essay-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);

    &__title {
      font-family: var(--font-family-headings);
      font-size: 2.65rem;
      font-weight: 600;
      line-height: 1.15;
      letter-spacing: -0.025em;
      color: var(--text-primary);
      margin-bottom: 0.6rem;

      @media (max-width: 680px) {
        font-size: 2.1rem;
      }
    }

    &__subtitle {
      font-family: var(--font-family-serif);
      font-size: 1.25rem;
      font-style: italic;
      color: var(--text-secondary);
      line-height: 1.4;
      margin-bottom: 1rem;
    }

    &__meta {
      font-family: var(--font-family-base);
      font-size: 0.8125rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      letter-spacing: 0.02em;
    }

    &__dot {
      opacity: 0.5;
    }
  }

  // Optional Cover Image
  .essay-cover {
    margin: 0 0 2.75rem 0;

    &__img {
      width: 100%;
      height: auto;
      max-height: 440px;
      object-fit: cover;
      border-radius: 8px;
      border: 1px solid var(--border-color);
      display: block;
    }

    &__caption {
      margin-top: 0.6rem;
      font-family: var(--font-family-base);
      font-size: 0.8125rem;
      color: var(--text-muted);
      text-align: center;
    }
  }

  .essay-footer {
    margin-top: 4.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border-color);

    &__author-name {
      font-family: var(--font-family-headings);
      font-size: 1.35rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 0.25rem;
    }

    &__author-bio {
      font-family: var(--font-family-base);
      font-size: 0.9375rem;
      color: var(--text-secondary);
      line-height: 1.6;
      margin-bottom: 2rem;
    }

    &__actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-family-base);
      font-size: 0.9375rem;
      font-weight: 500;
    }

    &__back-link {
      color: var(--accent-color);

      &:hover {
        text-decoration: underline;
      }
    }

    &__rss-link {
      color: var(--text-muted);

      &:hover {
        color: var(--text-primary);
      }
    }
  }
</style>
