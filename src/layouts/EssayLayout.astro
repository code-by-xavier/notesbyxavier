---
// File: src/layouts/EssayLayout.astro
// ============================================================
// Notesby — Essay Layout
// Editorial long-form reading layout with Table of Contents.
// ============================================================

import BaseLayout from '@/layouts/BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import type { HeadingItem } from '@/components/TableOfContents.astro';
import Icon from '@/components/Icon.astro';
import { getSiteSettings } from '@/lib/settings';
import { ROUTES } from '@/links';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  pubDate: Date | string;
  updatedDate?: Date | string;
  headings: HeadingItem[];
  coverImage?: string;
  coverImageAlt?: string;
  readingTime?: string;
  keywords?: string[] | string;
}

const {
  title,
  subtitle,
  description,
  pubDate,
  updatedDate,
  headings = [],
  coverImage,
  coverImageAlt,
  readingTime = '10 min read',
  keywords,
} = Astro.props;

const settings = await getSiteSettings();
---

<BaseLayout
  title={title}
  description={description}
  isEssay={true}
  pubDate={pubDate}
  updatedDate={updatedDate}
  image={coverImage}
  keywords={keywords}
>
  <div class="essay-layout">
    <div class="container essay-layout__container">
      <!-- Left: Table of Contents (Sticky sidebar for wide desktop screens) -->
      <TableOfContents headings={headings} />

      <!-- Center: Main Reading Column -->
      <article class="reading-container essay-article">
        <header class="essay-header">
          <div class="essay-header__meta">
            <time datetime={new Date(pubDate).toISOString()} class="essay-header__date">
              {new Date(pubDate).toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
              })}
            </time>
            {readingTime && <span class="essay-header__reading-time">{readingTime}</span>}
          </div>

          <h1 class="essay-header__title">{title}</h1>
          {subtitle && <p class="essay-header__subtitle">{subtitle}</p>}
        </header>

        <!-- Optional Header Cover Image -->
        {coverImage && (
          <figure class="essay-cover">
            <img src={coverImage} alt={coverImageAlt || title} class="essay-cover__img" />
            {coverImageAlt && <figcaption class="essay-cover__caption">{coverImageAlt}</figcaption>}
          </figure>
        )}

        <div class="prose-editorial essay-content">
          <slot />
        </div>

        <!-- Footnote / Author Sign-off -->
        <footer class="essay-footer">
          <div class="essay-footer__author">
            <div class="essay-footer__author-name">{settings.authorName}</div>
            <p class="essay-footer__author-bio">{settings.postBottomCopy || settings.authorBio}</p>
          </div>
          <div class="essay-footer__actions">
            <a href={ROUTES.HOME} class="essay-footer__back-link">
              ← Read all notes
            </a>
            <a href={ROUTES.RSS} class="essay-footer__rss-link">
              <Icon name="rss" size={13} class="rss-icon" color="var(--rss-accent, #f97316)" />
              <span>RSS Feed</span>
            </a>
          </div>
        </footer>
      </article>
    </div>
  </div>
</BaseLayout>

<style lang="scss">
  .essay-layout {
    padding-top: var(--feed-padding-top, #{ui.$feed-padding-top});

    &__container {
      display: flex;
      justify-content: center;
      gap: var(--page-section-gap, #{ui.$page-section-gap});
      position: relative;
    }
  }

  .essay-main {
    width: 100%;
    max-width: var(--reading-max-width, #{ui.$reading-max-width});
    min-width: 0;
  }

  .essay-header {
    margin-bottom: var(--spacing-xl, #{ui.$spacing-xl});
    padding-bottom: var(--spacing-lg, #{ui.$spacing-lg});
    border-bottom: var(--border-width-base, #{ui.$border-width-base}) solid
      var(--border-color, #{ui.$border-light});

    &__title {
      font-family: var(--font-family-headings, #{ui.$font-family-headings});
      font-size: var(--font-size-h1-desktop, #{ui.$font-size-h1-desktop});
      font-weight: ui.$font-weight-semibold;
      line-height: ui.$h1-line-height;
      letter-spacing: var(--letter-spacing-heading-lg, #{ui.$letter-spacing-heading-lg});
      color: var(--text-primary, #{ui.$text-primary-light});
      margin-bottom: var(--spacing-2xs-plus, #{ui.$spacing-2xs-plus});

      @include ui.media-breakpoint-down(sm) {
        font-size: var(--font-size-h1-mobile, #{ui.$font-size-h1-mobile});
      }
    }

    &__subtitle {
      @include ui.subtitle-serif-style(xl);
      margin-bottom: var(--spacing-unit, #{ui.$spacing-unit});
    }

    &__meta {
      @include ui.meta-row-style(sm, xs);
    }

    &__dot {
      opacity: 0.5;
    }
  }

  // Optional Cover Image
  .essay-cover {
    margin: 0 0 var(--spacing-3xl, #{ui.$spacing-3xl}) 0;

    &__img {
      width: 100%;
      height: auto;
      max-height: var(--cover-max-height, #{ui.$cover-max-height});
      object-fit: cover;
      border-radius: var(--border-radius-md, #{ui.$border-radius-md});
      border: var(--border-width-base, #{ui.$border-width-base}) solid
        var(--border-color, #{ui.$border-light});
      display: block;
    }

    &__caption {
      margin-top: var(--spacing-2xs-plus, #{ui.$spacing-2xs-plus});
      @include ui.meta-text-style(sm);
      text-align: center;
    }
  }

  .essay-footer {
    margin-top: var(--feed-padding-bottom, #{ui.$feed-padding-bottom});
    padding-top: var(--spacing-2xl, #{ui.$spacing-2xl});
    border-top: var(--border-width-base, #{ui.$border-width-base}) solid
      var(--border-color, #{ui.$border-light});

    &__author-name {
      font-family: var(--font-family-headings, #{ui.$font-family-headings});
      font-size: var(--h3-size, #{ui.$h3-font-size});
      font-weight: ui.$font-weight-semibold;
      color: var(--text-primary, #{ui.$text-primary-light});
      margin-bottom: var(--spacing-2xs, #{ui.$spacing-2xs});
    }

    &__author-bio {
      @include ui.description-text;
      font-size: var(--font-size-nav, #{ui.$font-size-nav});
      line-height: var(--line-height-prose, #{ui.$line-height-prose});
      margin-bottom: var(--spacing-xl, #{ui.$spacing-xl});
    }

    &__actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-family-base, #{ui.$font-family-base});
      font-size: var(--font-size-nav, #{ui.$font-size-nav});
      font-weight: ui.$font-weight-medium;
    }

    &__back-link {
      color: var(--accent-color, #{ui.$primary-accent});

      &:hover {
        text-decoration: underline;
      }
    }

    &__rss-link {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-3xs, #{ui.$spacing-3xs});
      color: var(--text-muted, #{ui.$text-muted-light});
      transition: color ui.$transition-fast;

      :global(.rss-icon),
      .rss-icon {
        color: var(--rss-accent, #{ui.$rss-accent}) !important;
        transition: color ui.$transition-fast;
      }

      &:hover {
        color: var(--text-primary, #{ui.$text-primary-light});

        :global(.rss-icon),
        .rss-icon {
          color: var(--rss-accent-hover, #{ui.$rss-accent-hover}) !important;
        }
      }
    }
  }
</style>
