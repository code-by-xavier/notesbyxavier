---
// File: src/layouts/BaseLayout.astro
// ============================================================
// Notesby — Base HTML & Shell Layout
// HTML skeleton, SEO meta tags, Google Fonts, and global styles.
// ============================================================

import Header from '@/components/Header.astro';
import SEO from '@/components/SEO.astro';
import SubscribePopup from '@/components/SubscribePopup.astro';
import { getSiteSettings } from '@/lib/settings';
import { ROUTES } from '@/links';
import '@/styles/main.scss';

interface Props {
  title?: string;
  description?: string;
  isEssay?: boolean;
  pubDate?: Date | string;
  updatedDate?: Date | string;
  image?: string;
  keywords?: string[] | string;
  hideNav?: boolean;
  hideFooter?: boolean;
  hidePopup?: boolean;
}

const {
  title,
  description,
  isEssay = false,
  pubDate,
  updatedDate,
  image,
  keywords,
  hideNav = false,
  hideFooter = false,
  hidePopup = false,
} = Astro.props;

const settings = await getSiteSettings();
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      title={title}
      description={description}
      isEssay={isEssay}
      pubDate={pubDate}
      updatedDate={updatedDate}
      image={image}
      keywords={keywords}
    />

    <!-- Inline Script to prevent Dark/Light theme flash -->
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem('notes-theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = savedTheme || (systemPrefersDark ? 'dark' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    {!hideNav && <Header isEssay={isEssay} />}

    <main>
      <slot />
    </main>

    {!hideFooter && (
      <footer class="site-footer">
        <div class="container site-footer__container">
          <div class="site-footer__left">
            <p class="site-footer__copyright">{settings.copyrightText}</p>
            <div class="site-footer__legal">
              <a href={ROUTES.TERMS} class="site-footer__link">
                Terms of Service
              </a>
              <span class="site-footer__dot" aria-hidden="true">
                &bull;
              </span>
              <a href={ROUTES.PRIVACY} class="site-footer__link">
                Privacy Policy
              </a>
              <span class="site-footer__dot" aria-hidden="true">
                &bull;
              </span>
              <a href={ROUTES.AI_POLICY} class="site-footer__link">
                AI Policy
              </a>
            </div>
          </div>
          <p class="site-footer__powered">{settings.colophonText}</p>
        </div>
      </footer>
    )}

    <style lang="scss">
      .site-footer {
        padding: var(--spacing-lg, #{ui.$spacing-lg}) 0;
        margin-top: var(--spacing-6xl, #{ui.$spacing-6xl});
        border-top: var(--border-width-base, #{ui.$border-width-base}) solid
          var(--border-color, #{ui.$border-light});
        font-size: var(--font-size-footer, #{ui.$font-size-footer});
        color: var(--text-muted, #{ui.$text-muted-light});

        &__container {
          display: flex;
          flex-direction: column;
          align-items: flex-start;
          gap: var(--spacing-md, #{ui.$spacing-md});
          text-align: left;

          @include ui.media-breakpoint-up(md) {
            flex-direction: row;
            justify-content: space-between;
            align-items: flex-start;
            gap: var(--spacing-lg, #{ui.$spacing-lg});
          }
        }

        &__left {
          display: flex;
          flex-direction: column;
          align-items: flex-start;
          gap: var(--spacing-xs, #{ui.$spacing-xs});
          text-align: left;
        }

        &__copyright {
          margin: 0;
          color: var(--text-muted, #{ui.$text-muted-light});
        }

        &__legal {
          display: inline-flex;
          align-items: center;
          gap: var(--spacing-2xs, #{ui.$spacing-2xs});
          text-align: left;
        }

        &__link {
          color: var(--accent-color, #{ui.$primary-accent});
          text-decoration: none;
          font-weight: ui.$font-weight-medium;
          transition:
            color ui.$transition-fast,
            text-decoration ui.$transition-fast;

          &:hover {
            color: var(--accent-hover, #{ui.$primary-accent-hover});
            text-decoration: underline;
          }
        }

        &__dot {
          color: var(--text-muted, #{ui.$text-muted-light});
          opacity: 0.5;
        }

        &__powered {
          margin: 0;
          color: var(--text-muted, #{ui.$text-muted-light});
        }
      }
    </style>
    {!hidePopup && <SubscribePopup settings={settings} />}
  </body>
</html>
