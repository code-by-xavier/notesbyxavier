---
// File: src/layouts/BaseLayout.astro
// ============================================================
// Notesby — Base HTML & Shell Layout
// HTML skeleton, SEO meta tags, Google Fonts, and global styles.
// ============================================================

import Header from '@/components/Header.astro';
import SEO from '@/components/SEO.astro';
import { notesConfig } from '@config';
import '@/styles/main.scss';

interface Props {
  title?: string;
  description?: string;
  isEssay?: boolean;
  pubDate?: Date | string;
  updatedDate?: Date | string;
  image?: string;
  hideNav?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description,
  isEssay = false,
  pubDate,
  updatedDate,
  image,
  hideNav = false,
  hideFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      title={title}
      description={description}
      isEssay={isEssay}
      pubDate={pubDate}
      updatedDate={updatedDate}
      image={image}
    />

    <!-- Inline Script to prevent Dark/Light theme flash -->
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem('notes-theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = savedTheme || (systemPrefersDark ? 'dark' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    {!hideNav && <Header isEssay={isEssay} />}

    <main>
      <slot />
    </main>

    {!hideFooter && (
      <footer class="site-footer">
        <div class="container site-footer__container">
          <p class="site-footer__copyright">{notesConfig.footer.copyrightText}</p>
          <p class="site-footer__powered">{notesConfig.footer.poweredByText}</p>
        </div>
      </footer>
    )}

    <style lang="scss">
      .site-footer {
        padding: var(--spacing-lg, #{ui.$spacing-lg}) 0;
        margin-top: var(--spacing-6xl, #{ui.$spacing-6xl});
        border-top: var(--border-width-base, #{ui.$border-width-base}) solid
          var(--border-color, #{ui.$border-light});
        font-size: var(--font-size-footer, #{ui.$font-size-footer});
        color: var(--text-muted, #{ui.$text-muted-light});

        &__container {
          display: flex;
          flex-direction: column;
          align-items: flex-start;
          gap: var(--spacing-xs, #{ui.$spacing-xs});
          text-align: left;

          @include ui.media-breakpoint-up(sm) {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            text-align: left;
          }
        }
      }
    </style>
  </body>
</html>
